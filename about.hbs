<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>FileGo Third-Party Licenses</title>
  <style>
    body { font-family: sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
    pre { white-space: pre-wrap; max-height: 24rem; overflow: auto; border: 1px solid #ccc; padding: 1rem; }
  </style>
</head>
<body>
  <h1>FileGo Third-Party Licenses</h1>
  <p>Generated from the dependency graph locked for this build.</p>
  {{#each licenses}}
    {{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
    <h3>{{name}}</h3>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
        <li>{{crate.name}} {{crate.version}}</li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
