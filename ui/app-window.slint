// FileGo — M03 main search window.
//
// Adapter design (documented):
//  - This file is intentionally "dumb": it renders state pushed from Rust
//    (exported globals `UiStrings` / `UiTheme`, plus root `in-out` state
//    properties) and forwards user gestures through `command-*` callbacks.
//    All decisions live in the pure-Rust `presentation::view_model::SearchViewModel`
//    (single source of truth).
//  - Resolved UI strings are pushed into the `UiStrings` global from Rust (the
//    i18n catalog in `presentation::i18n`), NOT via Slint's built-in `@tr()`.
//    Rationale: the logic layer holds no presentation text and the zh/en
//    key-parity tests run as plain Rust without a Slint compilation.
//  - Theme tokens are pushed into the `UiTheme` global from Rust. The bundled
//    Fluent widgets resolve their own palette from `Palette.color-scheme`,
//    which the adapter sets to match (`ColorScheme.Light`/`Dark`).
//  - IME gate hook point: the adapter sets `ime-composing` here AND
//    `SearchViewModel::set_ime_composition` when native preedit starts/ends
//    (M04+ native adapter). While composing, the input's `key-pressed` handler
//    rejects Enter/arrow keys so they reach the IME (which owns them) instead
//    of triggering result actions. The ViewModel gate is a second, logic-level
//    defense for any path around the UI. In Slint 1.18 the only UI-side signal
//    is `TextInput.preedit-text` (internal); final native wiring is a
//    manual-acceptance item (M03 task list).
//
// Keyboard routing (M03.3):
//  - Search LineEdit `key-pressed`: Enter→open, Escape→close, ↑/↓→navigate,
//    Alt+H→toggle hints. All other keys (including Ctrl+A, Ctrl+Backspace,
//    Ctrl+C) return `reject` so the native text behavior is kept.
//  - Results list is wrapped in a FocusScope (tab order: search → results); its
//    key-pressed handles ↑/↓/Enter and Ctrl+C (copy path).
//  - While `ime-composing` is set, Enter/↑/↓ are rejected to the IME.

import { Button, HorizontalBox, LineEdit, ScrollView, VerticalBox } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// Exported globals: strings + theme, pushed from Rust (i18n module + theme.rs)
// ---------------------------------------------------------------------------
export global UiStrings {
    in-out property <string> search-placeholder: "";
    in-out property <string> clear: "";
    in-out property <string> empty-hint: "";
    in-out property <string> no-data-title: "";
    in-out property <string> no-data-body: "";
    in-out property <string> filtered-title: "";
    in-out property <string> filtered-body: "";
    in-out property <string> no-match-title: "";
    in-out property <string> no-match-body: "";
    in-out property <string> error-load-title: "";
    in-out property <string> error-load-body: "";
    in-out property <string> error-save-title: "";
    in-out property <string> error-save-body: "";
    in-out property <string> error-search-title: "";
    in-out property <string> error-search-body: "";
    in-out property <string> hint-select: "";
    in-out property <string> hint-open: "";
    in-out property <string> hint-close: "";
    in-out property <string> hint-toggle: "";
    in-out property <string> count: "";
    in-out property <string> inaccessible: "";
    in-out property <string> inaccessible-tooltip: "";
    // ---- M05 settings window strings (pushed from Rust) ----
    in-out property <string> settings-title: "";
    in-out property <string> page-folders: "";
    in-out property <string> page-categories: "";
    in-out property <string> page-tags: "";
    in-out property <string> col-name: "";
    in-out property <string> col-path: "";
    in-out property <string> col-status: "";
    in-out property <string> col-actions: "";
    in-out property <string> action-add: "";
    in-out property <string> action-edit: "";
    in-out property <string> action-remove: "";
    in-out property <string> action-toggle-enabled: "";
    in-out property <string> action-toggle-pin: "";
    in-out property <string> action-check: "";
    in-out property <string> action-favorite: "";
    in-out property <string> filter-name-placeholder: "";
    in-out property <string> uncategorized-label: "";
    in-out property <string> enabled-label: "";
    in-out property <string> disabled-label: "";
    in-out property <string> pinned-label: "";
    in-out property <string> notice-saved: "";
    in-out property <string> notice-save-failed: "";
    in-out property <string> notice-removed: "";
    in-out property <string> notice-restored: "";
    in-out property <string> notice-undo-expired: "";
    in-out property <string> notice-cannot-undo: "";
    in-out property <string> notice-duplicate-blocked: "";
    in-out property <string> notice-invalid-path: "";
    in-out property <string> notice-invalid-name: "";
    in-out property <string> notice-not-found: "";
    in-out property <string> notice-path-accessible: "";
    in-out property <string> notice-path-inaccessible: "";
    in-out property <string> notice-import-limited: "";
    in-out property <string> remove-confirm: "";
    in-out property <string> remove-never-deletes: "";
    in-out property <string> undo: "";
    in-out property <string> add-dialog-title: "";
    in-out property <string> edit-dialog-title: "";
    in-out property <string> field-name: "";
    in-out property <string> field-path: "";
    in-out property <string> field-not-empty: "";
    in-out property <string> field-duplicate: "";
    in-out property <string> save: "";
    in-out property <string> cancel: "";
    in-out property <string> paste: "";
    in-out property <string> browse: "";
    in-out property <string> import-offer-title: "";
    in-out property <string> import-parent-only: "";
    in-out property <string> import-children: "";
    in-out property <string> import-max-hint: "";
    in-out property <string> import-second-confirm: "";
    in-out property <string> batch-preview-title: "";
    in-out property <string> batch-add: "";
    in-out property <string> batch-status-duplicate: "";
    in-out property <string> batch-status-invalid: "";
    in-out property <string> category-create: "";
    in-out property <string> category-rename: "";
    in-out property <string> category-delete: "";
    in-out property <string> tag-create: "";
    in-out property <string> tag-rename: "";
    in-out property <string> tag-merge-to: "";
    in-out property <string> tag-delete: "";
    in-out property <string> usage-suffix: "";
    in-out property <string> confirm-delete-category: "";
    in-out property <string> confirm-delete-tag: "";
    in-out property <string> import-setting-off-hint: "";
}

export global UiTheme {
    in-out property <color> background: #F7F8FA;
    in-out property <color> surface: #FFFFFF;
    in-out property <color> border: #E2E5EA;
    in-out property <color> text: #1B1B1F;
    in-out property <color> text-secondary: #5F6368;
    in-out property <color> accent: #005FB8;
    in-out property <color> on-accent: #FFFFFF;
    in-out property <color> warning: #8A5A00;
    in-out property <color> selection: #DEEBFA;
    // NOTE(M03.4): the bundled Fluent widgets resolve their palette from
    // SlintInternal.color-scheme (context level). Setting that context scheme
    // from Rust is not in Slint 1.18's public `Window` API; the system-detection
    // hook therefore lives in `ResolvedTheme::resolve`, and the adapter passes a
    // concrete scheme. Native dark-mode switching for the *widget palette* is a
    // documented manual-acceptance item (M07.x / M08).
}

// ---------------------------------------------------------------------------
// Result row component (56px, two lines).
// ---------------------------------------------------------------------------
component ResultRow inherits Rectangle {
    in property <int> row-index;
    in property <string> row-name;
    in property <string> row-path;
    in property <string> row-full-path;
    in property <string> row-category;
    in property <string> row-tags;
    in property <bool> row-inaccessible;
    in property <bool> row-selected;

    // Callbacks the AppWindow wires to commands.
    callback row-clicked(int);
    callback row-activated(int);

    height: 56px;
    border-radius: 8px;
    border-width: 1px;
    border-color: row-selected ? UiTheme.accent : UiTheme.border;
    background: row-selected ? UiTheme.selection : transparent;

    // a11y: not color-only — the accessible label and the secondary text line
    // also carry the inaccessible state (text/glyph).
    accessible-role: list-item;
    accessible-label: row-name + (row-inaccessible ? " (" + UiStrings.inaccessible + ")" : "");
    accessible-item-selectable: true;
    accessible-item-selected: row-selected;
    accessible-item-index: row-index;

    TouchArea {
        // M03.3: single click selects, double-click opens.
        clicked() => {
            root.row-clicked(root.row-index);
        }
        double-clicked() => {
            root.row-activated(root.row-index);
        }
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;

        // line 1: name (+ status glyph for inaccessible)
        HorizontalLayout {
            spacing: 6px;

            Text {
                text: row-name;
                color: row-inaccessible ? UiTheme.warning : UiTheme.text;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if (row-inaccessible): Text {
                text: "⚠ " + UiStrings.inaccessible;
                color: UiTheme.warning;
                font-size: 12px;
                vertical-alignment: center;
                Tooltip {
                    Text {
                        text: UiStrings.inaccessible-tooltip;
                    }
                }
            }
        }

        // line 2: path label · category · tag with ellipsis; the Tooltip shows
        // the full path (F002), not the elided label.
        Text {
            text: row-path + (!row-category.is-empty ? " · " + row-category : "")
                   + (!row-tags.is-empty ? " · " + row-tags : "");
            color: UiTheme.text-secondary;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
            vertical-stretch: 1;
            Tooltip {
                Text {
                    text: row-full-path.is-empty ? row-path : row-full-path;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Main window.
// ---------------------------------------------------------------------------
export component AppWindow inherits Window {
    title: "FileGo";
    icon: @image-url("../assets/icons/filego.png");
    preferred-width: 600px;
    min-width: 480px;
    max-width: 760px;
    preferred-height: 140px;
    no-frame: true;
    always-on-top: true;

    // --- adapter-in state (pushed from Rust) -----------------------------
    in-out property <string> state-query: "";
    in-out property <int> state-selected: -1;
    in-out property <bool> state-busy: false;
    in-out property <bool> state-stale: false;
    in-out property <bool> hints-visible: true;
    in-out property <bool> ime-composing: false;
    in-out property <bool> state-shows-empty: false;
    in-out property <string> state-empty-title: "";
    in-out property <string> state-empty-body: "";
    // Row data (parallel arrays the adapter updates in one push).
    in-out property <int> rows-count: 0;
    in-out property <[string]> rows-name: [];
    in-out property <[string]> rows-path: [];
    in-out property <[string]> rows-full-path: [];
    in-out property <[string]> rows-category: [];
    in-out property <[string]> rows-tags: [];
    in-out property <[bool]> rows-inaccessible: [];

    // --- callbacks (commands to Rust) ------------------------------------
    callback command-query-edited(string);
    callback command-clear-query();
    callback command-navigate-up();
    callback command-navigate-down();
    callback command-escape();
    callback command-toggle-hints();
    callback command-select-index(int);
    callback command-open-index(int);
    callback command-open-selected();
    callback command-copy-path();
    callback command-set-overlay(bool);
    callback hide-requested();

    background: UiTheme.background;
    default-font-family: "Segoe UI Variable, Microsoft YaHei UI, sans-serif";
    default-font-size: 14px;

    // ------------------------------------------------------------------
    // Root stack: search box, results area, hint bar.
    // ------------------------------------------------------------------
    VerticalBox {
        padding: 12px;
        spacing: 8px;

        // Search box --------------------------------------------------
        Rectangle {
            height: 56px;
            border-radius: 14px;
            border-width: 1px;
            border-color: UiTheme.border;
            background: UiTheme.surface;

            // search icon (magnifier glyph)
            Text {
                x: 14px;
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 22px;
                text: "🔍";
                font-size: 18px;
                color: UiTheme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-label: "search";
            }

            LineEdit {
                x: 46px;
                y: 6px;
                width: parent.width - 46px - (!root.state-query.is-empty ? 44px : 12px);
                height: 44px;
                placeholder-text: UiStrings.search-placeholder;
                font-size: 16px;
                text: root.state-query;

                // M03.3 keyboard routing. Enter/arrows/Escape are intercepted;
                // everything else falls through to native text behavior.
                key-pressed(event) => {
                    if (root.ime-composing) {
                        // The IME owns the keys during composition.
                        reject
                    } else if (event.text == Key.Return) {
                        root.command-open-selected();
                        accept
                    } else if (event.text == Key.Escape) {
                        root.command-escape();
                        accept
                    } else if (event.text == Key.UpArrow) {
                        root.command-navigate-up();
                        accept
                    } else if (event.text == Key.DownArrow) {
                        root.command-navigate-down();
                        accept
                    } else if (event.modifiers.alt && event.text == Key.H) {
                        root.command-toggle-hints();
                        accept
                    } else {
                        // Ctrl+A, Ctrl+Backspace, Ctrl+C and plain text stay native.
                        reject
                    }
                }

                edited(text) => { root.command-query-edited(text); }
                accepted(text) => { root.command-open-selected(); }
            }

            // conditional clear button: only when the query is non-empty.
            if (!root.state-query.is-empty): Rectangle {
                x: parent.width - 38px;
                y: (parent.height - 28px) / 2;
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: UiTheme.selection;

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "✕";
                    font-size: 13px;
                    color: UiTheme.text;
                    accessible-role: button;
                    accessible-label: UiStrings.clear;
                }

                TouchArea {
                    clicked() => { root.command-clear-query(); }
                }
            }
        }

        // Results area (compact window hides it until there is something) ---
        if (root.rows-count > 0 || root.state-busy || root.state-shows-empty): VerticalBox {
            spacing: 4px;

            // FocusScope for the results list: tab target after the search box.
            results-focus := FocusScope {
                focus-on-tab-navigation: true;

                key-pressed(event) => {
                    if (event.text == Key.UpArrow) {
                        root.command-navigate-up();
                        accept
                    } else if (event.text == Key.DownArrow) {
                        root.command-navigate-down();
                        accept
                    } else if (event.text == Key.Return) {
                        root.command-open-selected();
                        accept
                    } else if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                        // Ctrl+C on a focused result copies its path.
                        root.command-copy-path();
                        accept
                    } else if (event.text == Key.Escape) {
                        root.command-escape();
                        accept
                    } else {
                        reject
                    }
                }

                Rectangle {
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: UiTheme.border;
                    background: UiTheme.surface;
                    min-height: 0px;
                    max-height: 480px;

                    // results list (rows pushed from Rust as parallel arrays)
                    VerticalBox {
                        padding: 4px;
                        spacing: 2px;
                        width: 100%;

                        for row[i] in root.rows-name: ResultRow {
                            row-index: i;
                            row-name: root.rows-name[i];
                            row-path: root.rows-path[i];
                            row-full-path: root.rows-full-path[i];
                            row-category: root.rows-category[i];
                            row-tags: root.rows-tags[i];
                            row-inaccessible: root.rows-inaccessible[i];
                            row-selected: root.state-selected == i;
                            row-clicked(index) => { root.command-select-index(index); }
                            row-activated(index) => {
                                root.command-select-index(index);
                                root.command-open-index(index);
                            }
                        }

                        // empty/error state (title + body pushed from Rust)
                        if (root.rows-name.length == 0 && root.state-shows-empty): Rectangle {
                            height: 72px;
                            width: 100%;

                            Text {
                                x: 16px;
                                y: 6px;
                                width: parent.width - 32px;
                                text: root.state-empty-title;
                                color: UiTheme.text;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            Text {
                                x: 16px;
                                y: 30px;
                                width: parent.width - 32px;
                                text: root.state-empty-body;
                                color: UiTheme.text-secondary;
                                font-size: 13px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        // plain empty query hint (no results, not busy)
                        if (root.rows-name.length == 0 && !root.state-shows-empty && !root.state-busy): Rectangle {
                            height: 48px;
                            width: 100%;

                            Text {
                                x: 16px;
                                y: 12px;
                                width: parent.width - 32px;
                                text: UiStrings.empty-hint;
                                color: UiTheme.text-secondary;
                                font-size: 14px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            if (root.rows-count > 0): Text {
                text: UiStrings.count;
                color: UiTheme.text-secondary;
                font-size: 12px;
            }
        }

        // Keyboard hint bar (hideable via Alt+H) --------------------------
        if (root.hints-visible): Rectangle {
            height: 28px;
            border-radius: 8px;
            background: UiTheme.surface;
            border-width: 1px;
            border-color: UiTheme.border;

            HorizontalBox {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 2px;
                padding-bottom: 2px;
                alignment: start;
                spacing: 12px;

                Text { text: UiStrings.hint-select; color: UiTheme.text-secondary; font-size: 12px; }
                Text { text: UiStrings.hint-open; color: UiTheme.text-secondary; font-size: 12px; }
                Text { text: UiStrings.hint-close; color: UiTheme.text-secondary; font-size: 12px; }
                Text { text: UiStrings.hint-toggle; color: UiTheme.text-secondary; font-size: 12px; }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// M05 settings window local components (declared before use).
// ---------------------------------------------------------------------------
component NoticeBar inherits Rectangle {
    in property <string> v-text;
    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: UiTheme.border;
    background: UiTheme.selection;
    visible: !root.v-text.is-empty;
    Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.v-text;
        color: UiTheme.text;
        font-size: 12px;
    }
}

component FolderManagementRow inherits HorizontalBox {
    in property <int> m-id;
    in property <string> m-name;
    in property <string> m-path;
    in property <string> m-category;
    in property <string> m-tags;
    in property <bool> m-enabled;
    in property <bool> m-pinned;
    callback command-edit(int);
    callback command-remove(int);
    callback command-toggle-enabled(int);
    callback command-toggle-pin(int);
    callback command-check(int);
    spacing: 8px;
    height: 44px;

    VerticalBox {
        horizontal-stretch: 2;
        spacing: 0px;
        Text { text: root.m-name + (root.m-pinned ? " 📌" : ""); color: UiTheme.text; font-size: 13px; }
        Text { text: root.m-path; color: UiTheme.text-secondary; font-size: 11px; overflow: elide; }
    }
    VerticalBox {
        horizontal-stretch: 1;
        Text { text: root.m-category; color: UiTheme.text-secondary; font-size: 12px; }
        Text { text: root.m-tags; color: UiTheme.text-secondary; font-size: 11px; overflow: elide; }
    }
    Text { text: root.m-enabled ? UiStrings.enabled-label : UiStrings.disabled-label; color: root.m-enabled ? UiTheme.accent : UiTheme.warning; font-size: 11px; }
    Button { text: UiStrings.action-toggle-enabled; clicked() => { root.command-toggle-enabled(root.m-id); } }
    Button { text: UiStrings.action-toggle-pin; clicked() => { root.command-toggle-pin(root.m-id); } }
    Button { text: UiStrings.action-edit; clicked() => { root.command-edit(root.m-id); } }
    Button { text: UiStrings.action-remove; clicked() => { root.command-remove(root.m-id); } }
    Button { text: UiStrings.action-check; clicked() => { root.command-check(root.m-id); } }
}

// ---------------------------------------------------------------------------
// M05 settings management window (merged into one .slint so slint-build's
// `compile` emits a single module; slint-build 1.18 emits one file per compile
// and the second overwrites SLINT_INCLUDE_GENERATED, so two files cannot be
// re-exported together).
// ---------------------------------------------------------------------------
export component SettingsWindow inherits Window {
    title: "FileGo — " + UiStrings.settings-title;
    preferred-width: 900px;
    min-width: 760px;
    preferred-height: 640px;
    min-height: 520px;
    background: UiTheme.background;

    // --- observable state pushed from Rust (ManagementController + i18n) ---
    in-out property <int> page: 0;
    in-out property <int> rows-count: 0;
    in-out property <[string]> rows-name: [];
    in-out property <[string]> rows-path: [];
    in-out property <[string]> rows-category: [];
    in-out property <[string]> rows-tags: [];
    in-out property <[bool]> rows-enabled: [];
    in-out property <[bool]> rows-pinned: [];
    in-out property <[bool]> rows-favorite: [];
    in-out property <[int]> rows-ids: [];
    in-out property <int> categories-count: 0;
    in-out property <[string]> categories-name: [];
    in-out property <[int]> categories-counts: [];
    in-out property <int> tags-count: 0;
    in-out property <[string]> tags-name: [];
    in-out property <[int]> tags-usage: [];
    in-out property <bool> import-offer-visible: false;
    in-out property <string> import-offer-parent: "";
    in-out property <int> import-offer-children: 0;
    in-out property <string> import-offer-hover: "";
    in-out property <string> notice-text: "";
    in-out property <bool> has-pending-remove: false;
    in-out property <string> pending-remove-name: "";
    in-out property <int> pending-remove-seconds: 0;

    // --- callbacks (commands to Rust) ---
    callback close-settings();
    callback command-show-page(int);
    callback command-add();
    callback command-paste();
    callback command-browse();
    callback command-edit(int);
    callback command-remove(int);
    callback command-toggle-enabled(int);
    callback command-toggle-pin(int);
    callback command-check(int);
    callback command-create-category(string);
    callback command-delete-category(int);
    callback command-create-tag(string);
    callback command-delete-tag(int);
    callback command-filter-name(string);
    callback command-confirm-remove();
    callback command-cancel-remove();
    callback command-undo-remove();
    callback command-import-parent-only();
    callback command-import-children();
    callback command-import-dismiss();
    callback command-save-draft();
    callback command-cancel-draft();
    callback command-set-draft-name(string);
    callback command-set-draft-path(string);
    callback command-set-draft-note(string);
    callback command-toggle-pinned();
    callback command-toggle-favorite();
    callback command-set-enabled(bool);
    callback command-apply-batch();
    callback command-cancel-batch();

    // --- local edit state for the drafts ---
    in-out property <string> draft-name: "";
    in-out property <string> draft-path: "";
    in-out property <string> draft-note: "";
    in-out property <bool> draft-visible: false;
    in-out property <string> draft-title: "";
    in-out property <string> draft-error: "";
    in-out property <color> draft-color: #00000000;
    in-out property <bool> batch-visible: false;
    in-out property <int> batch-count: 0;
    in-out property <[string]> batch-name: [];
    in-out property <[string]> batch-path: [];
    in-out property <[bool]> batch-dup: [];
    in-out property <[bool]> batch-invalid: [];

    HorizontalBox {
        padding: 12px;
        spacing: 12px;

        // ===== left navigation =====
        VerticalBox {
            width: 180px;
            spacing: 4px;
            Rectangle {
                height: 24px;
                Text { text: UiStrings.settings-title; color: UiTheme.text; font-size: 15px; font-weight: 600; }
            }
            Button {
                text: UiStrings.page-folders;
                checked: root.page == 0;
                clicked() => { root.command-show-page(0); }
            }
            Button {
                text: UiStrings.page-categories;
                checked: root.page == 1;
                clicked() => { root.command-show-page(1); }
            }
            Button {
                text: UiStrings.page-tags;
                checked: root.page == 2;
                clicked() => { root.command-show-page(2); }
            }
        }

        // ===== right content =====
        VerticalBox {
            horizontal-stretch: 1;
            spacing: 8px;

            NoticeBar { v-text: root.notice-text; }

            if (root.page == 0): VerticalBox {
                spacing: 8px;
                HorizontalBox {
                    spacing: 8px;
                    LineEdit {
                        placeholder-text: UiStrings.filter-name-placeholder;
                        horizontal-stretch: 1;
                        edited(text) => { root.command-filter-name(text); }
                    }
                    Button { text: UiStrings.action-add; clicked() => { root.command-add(); } }
                }
                ScrollView {
                    height: 400px;
                    VerticalBox {
                        spacing: 2px;
                        for i in root.rows-count: FolderManagementRow {
                            m-id: root.rows-ids[i];
                            m-name: root.rows-name[i];
                            m-path: root.rows-path[i];
                            m-category: root.rows-category[i];
                            m-tags: root.rows-tags[i];
                            m-enabled: root.rows-enabled[i];
                            m-pinned: root.rows-pinned[i];
                            command-edit(id) => { root.command-edit(id); }
                            command-remove(id) => { root.command-remove(id); }
                            command-toggle-enabled(id) => { root.command-toggle-enabled(id); }
                            command-toggle-pin(id) => { root.command-toggle-pin(id); }
                            command-check(id) => { root.command-check(id); }
                        }
                        if (root.rows-count == 0): Text {
                            text: UiStrings.field-not-empty;
                            color: UiTheme.text-secondary;
                            font-size: 13px;
                        }
                    }
                }
                if (root.has-pending-remove): Rectangle {
                    height: 72px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: UiTheme.border;
                    background: UiTheme.surface;
                    VerticalBox {
                        padding: 8px;
                        spacing: 4px;
                        Text { text: UiStrings.remove-confirm + " · " + root.pending-remove-name; color: UiTheme.text; font-size: 12px; }
                        Text { text: UiStrings.remove-never-deletes; color: UiTheme.warning; font-size: 11px; }
                        HorizontalBox {
                            spacing: 8px;
                            Button { text: UiStrings.undo; clicked() => { root.command-undo-remove(); } }
                            Button { text: UiStrings.cancel; clicked() => { root.command-cancel-remove(); } }
                        }
                    }
                }
            }

            if (root.page == 1): VerticalBox {
                spacing: 8px;
                HorizontalBox {
                    spacing: 8px;
                    cat-input := LineEdit {
                        placeholder-text: UiStrings.category-create;
                        horizontal-stretch: 1;
                        text: "";
                    }
                    Button { text: UiStrings.category-create; clicked() => { root.command-create-category(cat-input.text); cat-input.text = ""; } }
                }
                ScrollView {
                    height: 400px;
                    VerticalBox {
                        spacing: 2px;
                        for i in root.categories-count: HorizontalBox {
                            spacing: 8px;
                            height: 34px;
                            Text { text: root.categories-name[i]; color: UiTheme.text; font-size: 13px; horizontal-stretch: 1; }
                            Text { text: root.categories-counts[i] + UiStrings.usage-suffix; color: UiTheme.text-secondary; font-size: 12px; }
                            Button { text: UiStrings.category-delete; clicked() => { root.command-delete-category(i); } }
                        }
                        if (root.categories-count == 0): Text { text: UiStrings.field-not-empty; color: UiTheme.text-secondary; font-size: 13px; }
                    }
                }
            }

            if (root.page == 2): VerticalBox {
                spacing: 8px;
                HorizontalBox {
                    spacing: 8px;
                    tag-input := LineEdit {
                        placeholder-text: UiStrings.tag-create;
                        horizontal-stretch: 1;
                        text: "";
                    }
                    Button { text: UiStrings.tag-create; clicked() => { root.command-create-tag(tag-input.text); tag-input.text = ""; } }
                }
                ScrollView {
                    height: 400px;
                    VerticalBox {
                        spacing: 2px;
                        for i in root.tags-count: HorizontalBox {
                            spacing: 8px;
                            height: 34px;
                            Text { text: root.tags-name[i]; color: UiTheme.text; font-size: 13px; horizontal-stretch: 1; }
                            Text { text: root.tags-usage[i] + UiStrings.usage-suffix; color: UiTheme.text-secondary; font-size: 12px; }
                            Button { text: UiStrings.tag-delete; clicked() => { root.command-delete-tag(i); } }
                        }
                        if (root.tags-count == 0): Text { text: UiStrings.field-not-empty; color: UiTheme.text-secondary; font-size: 13px; }
                    }
                }
            }

            // ===== add/edit dialog =====
            if (root.draft-visible): Rectangle {
                width: 100%;
                border-radius: 10px;
                border-width: 1px;
                border-color: UiTheme.border;
                background: UiTheme.surface;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: root.draft-title; color: UiTheme.text; font-size: 14px; font-weight: 600; }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: UiStrings.field-name; color: UiTheme.text-secondary; }
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.draft-name;
                            edited(text) => { root.command-set-draft-name(text); }
                        }
                        Button { text: UiStrings.action-toggle-pin; clicked() => { root.command-toggle-pinned(); } }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: UiStrings.field-path; color: UiTheme.text-secondary; }
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.draft-path;
                            edited(text) => { root.command-set-draft-path(text); }
                        }
                        Button { text: UiStrings.paste; clicked() => { root.command-paste(); } }
                        Button { text: UiStrings.browse; clicked() => { root.command-browse(); } }
                    }
                    NoticeBar { v-text: root.draft-error; }
                    HorizontalBox {
                        alignment: end;
                        spacing: 8px;
                        Button { text: UiStrings.cancel; clicked() => { root.command-cancel-draft(); } }
                        Button { text: UiStrings.save; clicked() => { root.command-save-draft(); } }
                    }
                }
            }

            // ===== controlled one-level child import offer =====
            if (root.import-offer-visible): Rectangle {
                width: 100%;
                border-radius: 10px;
                border-width: 1px;
                border-color: UiTheme.border;
                background: UiTheme.surface;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: UiStrings.import-offer-title; color: UiTheme.text; font-size: 14px; font-weight: 600; }
                    Text {
                        text: root.import-offer-parent;
                        color: UiTheme.text-secondary;
                        font-size: 12px;
                        Tooltip { Text { text: root.import-offer-hover; } }
                    }
                    Text { text: UiStrings.import-second-confirm; color: UiTheme.warning; font-size: 12px; }
                    HorizontalBox {
                        spacing: 8px;
                        Button { text: UiStrings.import-parent-only; clicked() => { root.command-import-parent-only(); } }
                        Button { text: UiStrings.import-children + " (" + root.import-offer-children + ")"; clicked() => { root.command-import-children(); } }
                        Button { text: UiStrings.cancel; clicked() => { root.command-import-dismiss(); } }
                    }
                }
            }

            // ===== batch preview =====
            if (root.batch-visible): Rectangle {
                width: 100%;
                border-radius: 10px;
                border-width: 1px;
                border-color: UiTheme.border;
                background: UiTheme.surface;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: UiStrings.batch-preview-title; color: UiTheme.text; font-size: 14px; font-weight: 600; }
                    ScrollView {
                        horizontal-stretch: 1;
                        VerticalBox {
                            for i in root.batch-count: HorizontalBox {
                                spacing: 8px;
                                Text { text: root.batch-name[i]; color: UiTheme.text; font-size: 12px; horizontal-stretch: 1; }
                                if (root.batch-dup[i]): Text { text: UiStrings.batch-status-duplicate; color: UiTheme.warning; font-size: 12px; }
                                if (root.batch-invalid[i]): Text { text: UiStrings.batch-status-invalid; color: UiTheme.warning; font-size: 12px; }
                            }
                        }
                    }
                    HorizontalBox {
                        alignment: end;
                        spacing: 8px;
                        Button { text: UiStrings.cancel; clicked() => { root.command-cancel-batch(); } }
                        Button { text: UiStrings.batch-add; clicked() => { root.command-apply-batch(); } }
                    }
                }
            }
        }
    }
}

// Keep the tray shell (M00) intact — wiring stays in M04.
export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../assets/icons/filego-tray.png");
    title: "FileGo";
    tooltip: "FileGo";

    callback toggle-window();
    callback open-window();
    callback quit-requested();
    // ---- M04.1 tray actions ---------------------------------------------
    callback add-folder();
    callback open-settings();
    callback toggle-launch-at-login();
    callback toggle-pause-hotkeys();
    callback show-about();
    // Checkbox-style state is delivered as a text+glyph prefix (Slint's Windows
    // tray backend does not render `MF_CHECKED`; the task requires state to be
    // text+glyph, not color-only). The native menu rebuilds reactively when the
    // string changes. Empty when unchecked, "✓ " when checked. `in-out` so the
    // adapter can drive them from Rust (public setters are generated).
    in-out property <string> launch-at-login-glyph: "";
    in-out property <string> pause-hotkeys-glyph: "";

    clicked => { root.toggle-window(); }

    Menu {
        MenuItem {
            title: @tr("Open FileGo");
            activated => { root.open-window(); }
        }
        MenuItem {
            title: @tr("Add Folder…");
            activated => { root.add-folder(); }
        }
        MenuSeparator {}
        MenuItem {
            title: @tr("Settings");
            enabled: false; // M06 wires the settings window.
            activated => { root.open-settings(); }
        }
        MenuItem {
            title: root.launch-at-login-glyph + @tr("Launch at login");
            activated => { root.toggle-launch-at-login(); }
        }
        MenuItem {
            title: root.pause-hotkeys-glyph + @tr("Pause hotkeys");
            activated => { root.toggle-pause-hotkeys(); }
        }
        MenuSeparator {}
        MenuItem {
            title: @tr("About FileGo");
            activated => { root.show-about(); }
        }
        MenuSeparator {}
        MenuItem {
            title: @tr("Exit");
            activated => { root.quit-requested(); }
        }
    }
}
