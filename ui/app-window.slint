export global UiTheme {
    in-out property <color> background: #F7F8FA;
    in-out property <color> surface: #FFFFFF;
    in-out property <color> border: #E2E5EA;
    in-out property <color> text: #1B1B1F;
    in-out property <color> text-secondary: #5F6368;
    in-out property <color> accent: #005FB8;
    in-out property <color> on-accent: #FFFFFF;
    in-out property <color> warning: #8A5A00;
    in-out property <color> selection: #DEEBFA;
    // M06.4: font-scale percent / 100 applied to the window default font size
    // (80..=150). Both roots bind `default-font-size` to this, so the widgets
    // (Button/LineEdit/ComboBox/SpinBox/Switch) scale with the setting.
    in-out property <float> font-scale: 1.0;
    // NOTE(M03.4): the bundled Fluent widgets resolve their palette from
    // SlintInternal.color-scheme (context level). Setting that context scheme
    // from Rust is not in Slint 1.18's public `Window` API; the system-detection
    // hook therefore lives in `ResolvedTheme::resolve`, and the adapter passes a
    // concrete scheme. Native dark-mode switching for the *widget palette* is a
    // documented manual-acceptance item (M07.x / M08).
}

// ---------------------------------------------------------------------------
// Result row component (56px, two lines).
// ---------------------------------------------------------------------------
component ResultRow inherits Rectangle {
    in property <int> row-index;
    in property <string> row-name;
    in property <string> row-path;
    in property <string> row-full-path;
    in property <string> row-category;
    in property <string> row-tags;
    in property <bool> row-inaccessible;
    in property <bool> row-selected;
    // M05.5 context menu: the row reports its pin/enable state so the menu can
    // render the correct "置顶/取消置顶" and "禁用/恢复" labels.
    in property <bool> row-pinned;
    in property <bool> row-enabled;
    // M06.4: whether line 2 shows the path / category-tag text.
    in property <bool> row-show-path: true;
    in property <bool> row-show-cat-tag: true;

    // Callbacks the AppWindow wires to commands.
    callback row-clicked(int);
    callback row-activated(int);
    // M05.5: right-click on the row. Carries the row index plus the window-
    // absolute click position (logical) so the AppWindow can anchor its popup.
    callback row-context-requested(int, length, length);

    height: 56px;
    border-radius: 8px;
    border-width: 1px;
    border-color: row-selected ? UiTheme.accent : UiTheme.border;
    background: row-selected ? UiTheme.selection : transparent;

    // a11y: not color-only — the accessible label and the secondary text line
    // also carry the inaccessible state (text/glyph).
    accessible-role: list-item;
    accessible-label: row-name + (row-inaccessible ? " (" + UiStrings.inaccessible + ")" : "");
    accessible-item-selectable: true;
    accessible-item-selected: row-selected;
    accessible-item-index: row-index;

    public function request-context(x: length, y: length) {
        root.row-context-requested(root.row-index, x, y);
    }

    TouchArea {
        // M03.3: single click selects, double-click opens.
        clicked() => {
            root.row-clicked(root.row-index);
        }
        double-clicked() => {
            root.row-activated(root.row-index);
        }
        // M05.5: right-button release opens the context menu (popup-safe via
        // the adapter's overlay gate).
        pointer-event(pe) => {
            if (pe.button == PointerEventButton.right && pe.kind == PointerEventKind.up) {
                root.request-context(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;

        // line 1: name (+ status glyph for inaccessible)
        HorizontalLayout {
            spacing: 6px;

            Text {
                text: row-name;
                color: row-inaccessible ? UiTheme.warning : UiTheme.text;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if (row-inaccessible): Text {
                text: "⚠ " + UiStrings.inaccessible;
                color: UiTheme.warning;
                font-size: 12px;
                vertical-alignment: center;
                Tooltip {
                    Text {
                        text: UiStrings.inaccessible-tooltip;
                    }
                }
            }
        }

        // line 2: path label · category · tag with ellipsis; the Tooltip shows
        // the full path (F002), not the elided label. M06.4: path/category-tag
        // lines can be hidden by settings.
        if (root.row-show-path || root.row-show-cat-tag): Text {
            text: (root.row-show-path ? row-path : "")
                   + (root.row-show-path && root.row-show-cat-tag && (!row-category.is-empty || !row-tags.is-empty) ? " · " : "")
                   + (root.row-show-cat-tag ? row-category : "")
                   + (root.row-show-cat-tag && !row-tags.is-empty ? " · " + row-tags : "");
            color: UiTheme.text-secondary;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
            vertical-stretch: 1;
            Tooltip {
                Text {
                    text: row-full-path.is-empty ? row-path : row-full-path;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// M05.5 context menu (declared before the AppWindow that uses it).
// ---------------------------------------------------------------------------
// One row of the context menu.
component MenuRow inherits Rectangle {
    in property <string> m-text;
    callback menu-clicked;
    height: 30px;
    border-radius: 4px;

    TouchArea {
        clicked() => { root.menu-clicked(); }
    }
    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.m-text;
        color: UiTheme.text;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
    }
}

// The context-menu popup. Declared as its own component (PopupWindow becomes a
// separate component, so external element access is forbidden). Position and
// label state are fed through declared in-properties; each row instance
// connects its own `menu-clicked` callback to the declared `item-clicked(index)`;
// the AppWindow connects only that one.
component ContextMenuPopup inherits PopupWindow {
    in property <length> pos-x;
    in property <length> pos-y;
    in property <bool> menu-pinned;
    in property <bool> menu-enabled;
    callback item-clicked(int);
    close-policy: PopupClosePolicy.close-on-click-outside;
    x: root.pos-x;
    y: root.pos-y;

    Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: UiTheme.border;
        background: UiTheme.surface;

        VerticalLayout {
            spacing: 1px;

            m0 := MenuRow {
                m-text: UiStrings.context-menu-open;
                menu-clicked() => { root.item-clicked(0); }
            }
            m1 := MenuRow {
                m-text: UiStrings.context-menu-copy-path;
                menu-clicked() => { root.item-clicked(1); }
            }
            m2 := MenuRow {
                m-text: UiStrings.context-menu-copy-name;
                menu-clicked() => { root.item-clicked(2); }
            }
            m3 := MenuRow {
                m-text: UiStrings.context-menu-edit;
                menu-clicked() => { root.item-clicked(3); }
            }
            m4 := MenuRow {
                m-text: root.menu-pinned ? UiStrings.context-menu-unpin : UiStrings.context-menu-pin;
                menu-clicked() => { root.item-clicked(4); }
            }
            m5 := MenuRow {
                m-text: root.menu-enabled ? UiStrings.context-menu-disable : UiStrings.context-menu-enable;
                menu-clicked() => { root.item-clicked(5); }
            }
            m6 := MenuRow {
                m-text: UiStrings.context-menu-remove-record;
                menu-clicked() => { root.item-clicked(6); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Main window.
// ---------------------------------------------------------------------------
export component AppWindow inherits Window {
    title: "FileGo";
    icon: @image-url("../assets/icons/filego.png");
    preferred-width: 600px;
    min-width: 480px;
    max-width: 760px;
    preferred-height: 140px;
    no-frame: true;
    always-on-top: true;

    // --- adapter-in state (pushed from Rust) -----------------------------
    in-out property <string> state-query: "";
    in-out property <int> state-selected: -1;
    in-out property <bool> state-busy: false;
    in-out property <bool> state-stale: false;
    in-out property <bool> hints-visible: true;
    in-out property <bool> ime-composing: false;
    in-out property <bool> state-shows-empty: false;
    in-out property <string> state-empty-title: "";
    in-out property <string> state-empty-body: "";
    // Row data (parallel arrays the adapter updates in one push).
    in-out property <int> rows-count: 0;
    in-out property <[string]> rows-name: [];
    in-out property <[string]> rows-path: [];
    in-out property <[string]> rows-full-path: [];
    in-out property <[string]> rows-category: [];
    in-out property <[string]> rows-tags: [];
    in-out property <[bool]> rows-inaccessible: [];
    // M05.5: per-row pin/enable state for the context-menu labels.
    in-out property <[bool]> rows-pinned: [];
    in-out property <[bool]> rows-enabled: [];
    // Context menu state (anchored to the requested row).
    in-out property <int> ctx-menu: -1;
    in-out property <bool> ctx-pinned: false;
    in-out property <bool> ctx-enabled: true;
    in-out property <length> ctx-x: 0px;
    in-out property <length> ctx-y: 0px;
    // M06.4: result line-2 visibility (path + category/tag), pushed from Rust
    // along with the other appearance settings.
    in-out property <bool> show-path: true;
    in-out property <bool> show-cat-tag: true;

    // M05.5: keep the ViewModel overlay gate in sync with the popup. When the
    // popup closes on ANY path (item select, outside click, Escape), clear the
    // overlay so the window behaves normally again (Enter opens, Esc hides).
    // The Slint compiler redirects `context-menu.is-open` references from the
    // enclosing component to a synthesized parent property automatically.
    property <bool> ctx-menu-open: context-menu.is-open;
    changed ctx-menu-open => {
        if !root.ctx-menu-open {
            root.command-set-overlay(false);
        }
    }

    // --- callbacks (commands to Rust) ------------------------------------
    callback command-query-edited(string);
    callback command-clear-query();
    callback command-navigate-up();
    callback command-navigate-down();
    callback command-escape();
    callback command-toggle-hints();
    callback command-select-index(int);
    callback command-open-index(int);
    callback command-open-selected();
    callback command-copy-path();
    callback command-set-overlay(bool);
    callback hide-requested();
    // M05.5 context menu: request a row context action. `action` is a stable
    // code (0 open, 1 copy-path, 2 copy-name, 3 edit, 4 toggle-pin,
    // 5 toggle-enable, 6 remove-from-list); the adapter selects the row and
    // dispatches the matching RowAction.
    callback command-context-action(int, int);

    background: UiTheme.background;
    default-font-family: "Segoe UI Variable, Microsoft YaHei UI, sans-serif";
    default-font-size: 14px * UiTheme.font-scale;

    // ------------------------------------------------------------------
    // Root stack: search box, results area, hint bar.
    // ------------------------------------------------------------------
    VerticalBox {
        padding: 12px;
        spacing: 8px;

        // Search box --------------------------------------------------
        Rectangle {
            height: 56px;
            border-radius: 14px;
            border-width: 1px;
            border-color: UiTheme.border;
            background: UiTheme.surface;

            // search icon (magnifier glyph)
            Text {
                x: 14px;
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 22px;
                text: "🔍";
                font-size: 18px;
                color: UiTheme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-label: "search";
            }

            LineEdit {
                x: 46px;
                y: 6px;
                width: parent.width - 46px - (!root.state-query.is-empty ? 44px : 12px);
                height: 44px;
                placeholder-text: UiStrings.search-placeholder;
                font-size: 16px;
                text: root.state-query;

                // M03.3 keyboard routing. Enter/arrows/Escape are intercepted;
                // everything else falls through to native text behavior.
                key-pressed(event) => {
                    if (root.ime-composing) {
                        // The IME owns the keys during composition.
                        reject
                    } else if (event.text == Key.Return) {
                        root.command-open-selected();
                        accept
                    } else if (event.text == Key.Escape) {
                        root.command-escape();
                        accept
                    } else if (event.text == Key.UpArrow) {
                        root.command-navigate-up();
                        accept
                    } else if (event.text == Key.DownArrow) {
                        root.command-navigate-down();
                        accept
                    } else if (event.modifiers.alt && event.text == Key.H) {
                        root.command-toggle-hints();
                        accept
                    } else {
                        // Ctrl+A, Ctrl+Backspace, Ctrl+C and plain text stay native.
                        reject
                    }
                }

                edited(text) => { root.command-query-edited(text); }
                accepted(text) => { root.command-open-selected(); }
            }

            // conditional clear button: only when the query is non-empty.
            if (!root.state-query.is-empty): Rectangle {
                x: parent.width - 38px;
                y: (parent.height - 28px) / 2;
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: UiTheme.selection;

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "✕";
                    font-size: 13px;
                    color: UiTheme.text;
                    accessible-role: button;
                    accessible-label: UiStrings.clear;
                }

                TouchArea {
                    clicked() => { root.command-clear-query(); }
                }
            }
        }

        // Results area (compact window hides it until there is something) ---
        if (root.rows-count > 0 || root.state-busy || root.state-shows-empty): VerticalBox {
            spacing: 4px;

            // FocusScope for the results list: tab target after the search box.
            results-focus := FocusScope {
                focus-on-tab-navigation: true;

                key-pressed(event) => {
                    if (event.text == Key.UpArrow) {
                        root.command-navigate-up();
                        accept
                    } else if (event.text == Key.DownArrow) {
                        root.command-navigate-down();
                        accept
                    } else if (event.text == Key.Return) {
                        root.command-open-selected();
                        accept
                    } else if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                        // Ctrl+C on a focused result copies its path.
                        root.command-copy-path();
                        accept
                    } else if (event.text == Key.Escape) {
                        root.command-escape();
                        accept
                    } else {
                        reject
                    }
                }

                Rectangle {
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: UiTheme.border;
                    background: UiTheme.surface;
                    min-height: 0px;
                    max-height: 480px;

                    // results list (rows pushed from Rust as parallel arrays)
                    VerticalBox {
                        padding: 4px;
                        spacing: 2px;
                        width: 100%;

                        for row[i] in root.rows-name: ResultRow {
                            row-index: i;
                            row-name: root.rows-name[i];
                            row-path: root.rows-path[i];
                            row-full-path: root.rows-full-path[i];
                            row-category: root.rows-category[i];
                            row-tags: root.rows-tags[i];
                            row-inaccessible: root.rows-inaccessible[i];
                            row-selected: root.state-selected == i;
                            row-pinned: root.rows-pinned.length > i ? root.rows-pinned[i] : false;
                            row-enabled: root.rows-enabled.length > i ? root.rows-enabled[i] : true;
                            row-show-path: root.show-path;
                            row-show-cat-tag: root.show-cat-tag;
                            row-clicked(index) => { root.command-select-index(index); }
                            row-activated(index) => {
                                root.command-select-index(index);
                                root.command-open-index(index);
                            }
                            row-context-requested(index, x, y) => {
                                root.command-select-index(index);
                                root.command-set-overlay(true);
                                root.ctx-menu = index;
                                root.ctx-pinned = root.rows-pinned.length > index ? root.rows-pinned[index] : false;
                                root.ctx-enabled = root.rows-enabled.length > index ? root.rows-enabled[index] : true;
                                root.ctx-x = x;
                                root.ctx-y = y;
                                context-menu.show();
                            }
                        }

                        // empty/error state (title + body pushed from Rust)
                        if (root.rows-name.length == 0 && root.state-shows-empty): Rectangle {
                            height: 72px;
                            width: 100%;

                            Text {
                                x: 16px;
                                y: 6px;
                                width: parent.width - 32px;
                                text: root.state-empty-title;
                                color: UiTheme.text;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            Text {
                                x: 16px;
                                y: 30px;
                                width: parent.width - 32px;
                                text: root.state-empty-body;
                                color: UiTheme.text-secondary;
                                font-size: 13px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        // plain empty query hint (no results, not busy)
                        if (root.rows-name.length == 0 && !root.state-shows-empty && !root.state-busy): Rectangle {
                            height: 48px;
                            width: 100%;

                            Text {
                                x: 16px;
                                y: 12px;
                                width: parent.width - 32px;
                                text: UiStrings.empty-hint;
                                color: UiTheme.text-secondary;
                                font-size: 14px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            if (root.rows-count > 0): Text {
                text: UiStrings.count;
                color: UiTheme.text-secondary;
                font-size: 12px;
            }
        }

        // Keyboard hint bar (hideable via Alt+H) --------------------------
        if (root.hints-visible): Rectangle {
            height: 28px;
            border-radius: 8px;
            background: UiTheme.surface;
            border-width: 1px;
            border-color: UiTheme.border;

            HorizontalBox {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 2px;
                padding-bottom: 2px;
                alignment: start;
                spacing: 12px;

                Text { text: UiStrings.hint-select; color: UiTheme.text-secondary; font-size: 12px; }
                Text { text: UiStrings.hint-open; color: UiTheme.text-secondary; font-size: 12px; }
                Text { text: UiStrings.hint-close; color: UiTheme.text-secondary; font-size: 12px; }
                Text { text: UiStrings.hint-toggle; color: UiTheme.text-secondary; font-size: 12px; }
            }
        }
    }

    // M05.5 context menu (a single popup anchored to the right-clicked row).
    // The ViewModel's overlay gate (`command-set-overlay`) stays open while
    // this popup is shown so hide-on-focus-loss never tears the window away.
    // Each item carries a `clicked(index)` callback (no access from outside
    // the popup is allowed); the AppWindow dispatches the action and closes
    // the overlay. `close-on-click-outside` dismisses on an outside click or
    // Escape for the dismiss-only path.
    context-menu := ContextMenuPopup {
        pos-x: root.ctx-x;
        pos-y: root.ctx-y;
        menu-pinned: root.ctx-pinned;
        menu-enabled: root.ctx-enabled;
        item-clicked(index) => {
            context-menu.close();
            root.command-set-overlay(false);
            root.command-context-action(root.ctx-menu, index);
        }
    }
}

// ---------------------------------------------------------------------------
// M05 settings window local components (declared before use).
// ---------------------------------------------------------------------------
component NoticeBar inherits Rectangle {
    in property <string> v-text;
    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: UiTheme.border;
    background: UiTheme.selection;
    visible: !root.v-text.is-empty;
    Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.v-text;
        color: UiTheme.text;
        font-size: 12px;
    }
}

// A settings row with a single Switch (live toggle). `future` rows are honest
// "后续版本" placeholders (no hidden behavior). `t-checked <=> root.<prop>`
// two-way binds at the use site, so when the user toggles, `root.<prop>` is
// already the NEW value by the time `t-toggle()` fires (the adapter reads it).
component SwitchRow inherits HorizontalBox {
    in-out property <string> m-text;
    in-out property <bool> t-checked;
    in-out property <bool> future;
    callback t-toggle();
    spacing: 8px;
    height: 32px;
    Text {
        text: root.m-text;
        color: root.future ? UiTheme.text-secondary : UiTheme.text;
        font-size: 13px;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
    if root.future : Text {
        text: UiStrings.settings-appearance-future-version;
        color: UiTheme.text-secondary;
        font-size: 11px;
        vertical-alignment: center;
    }
    if !root.future : Switch {
        checked <=> root.t-checked;
        toggled() => { root.t-toggle(); }
    }
}

// A labelled rounded card for inline confirm panels / control containers.
component RoundBox inherits Rectangle {
    border-radius: 8px;
    border-width: 1px;
    border-color: UiTheme.border;
    background: UiTheme.surface;
    @children
}

// A settings row where the trailing control (ComboBox / SpinBox) is declared by
// the caller inside a RoundBox. The child binds `current-index <=> root.<prop>`
// so the adapter reads the new value from the `selected(...)` callback.
component ComboRow inherits HorizontalBox {
    in-out property <string> m-text;
    spacing: 8px;
    height: 32px;
    Text {
        text: root.m-text;
        color: UiTheme.text;
        font-size: 13px;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
    RoundBox {
        width: 260px;
        height: 28px;
        VerticalBox {
            padding-top: 3px;
            padding-bottom: 3px;
            @children
        }
    }
}

component FolderManagementRow inherits HorizontalBox {
    in property <int> m-id;
    in property <string> m-name;
    in property <string> m-path;
    in property <string> m-category;
    in property <string> m-tags;
    in property <bool> m-enabled;
    in property <bool> m-pinned;
    // M06.4: compact (34px) vs standard (44px) management rows.
    in property <bool> compact-rows: false;
    callback command-edit(int);
    callback command-remove(int);
    callback command-toggle-enabled(int);
    callback command-toggle-pin(int);
    callback command-check(int);
    spacing: 8px;
    height: root.compact-rows ? 34px : 44px;

    VerticalBox {
        horizontal-stretch: 2;
        spacing: 0px;
        Text { text: root.m-name + (root.m-pinned ? " 📌" : ""); color: UiTheme.text; font-size: 13px; }
        Text { text: root.m-path; color: UiTheme.text-secondary; font-size: 11px; overflow: elide; }
    }
    VerticalBox {
        horizontal-stretch: 1;
        Text { text: root.m-category; color: UiTheme.text-secondary; font-size: 12px; }
        Text { text: root.m-tags; color: UiTheme.text-secondary; font-size: 11px; overflow: elide; }
    }
    Text { text: root.m-enabled ? UiStrings.enabled-label : UiStrings.disabled-label; color: root.m-enabled ? UiTheme.accent : UiTheme.warning; font-size: 11px; }
    // M05 review H4: the enable/disable toggle button shows the *action* for the
    // opposite state (禁用 when now-enabled, 恢复 when now-disabled), never a
    // generic "添加" label.
    Button { text: root.m-enabled ? UiStrings.context-menu-disable : UiStrings.context-menu-enable; clicked() => { root.command-toggle-enabled(root.m-id); } }
    Button { text: UiStrings.action-toggle-pin; clicked() => { root.command-toggle-pin(root.m-id); } }
    Button { text: UiStrings.action-edit; clicked() => { root.command-edit(root.m-id); } }
    Button { text: UiStrings.action-remove; clicked() => { root.command-remove(root.m-id); } }
    Button { text: UiStrings.action-check; clicked() => { root.command-check(root.m-id); } }
}

// ---------------------------------------------------------------------------
// M05 settings management window (merged into one .slint so slint-build's
// `compile` emits a single module; slint-build 1.18 emits one file per compile
// and the second overwrites SLINT_INCLUDE_GENERATED, so two files cannot be
// re-exported together).
// ---------------------------------------------------------------------------
export component SettingsWindow inherits Window {
    title: "FileGo — " + UiStrings.settings-title;
    preferred-width: 900px;
    min-width: 760px;
    preferred-height: 640px;
    min-height: 520px;
    background: UiTheme.background;
    default-font-family: "Segoe UI Variable, Microsoft YaHei UI, sans-serif";
    default-font-size: 14px * UiTheme.font-scale;

    // --- observable state pushed from Rust (ManagementController + i18n) ---
    in-out property <int> page: 0;
    in-out property <int> rows-count: 0;
    in-out property <[string]> rows-name: [];
    in-out property <[string]> rows-path: [];
    in-out property <[string]> rows-category: [];
    in-out property <[string]> rows-tags: [];
    in-out property <[bool]> rows-enabled: [];
    in-out property <[bool]> rows-pinned: [];
    in-out property <[bool]> rows-favorite: [];
    in-out property <int> categories-count: 0;
    in-out property <[string]> categories-name: [];
    in-out property <[int]> categories-counts: [];
    in-out property <int> tags-count: 0;
    in-out property <[string]> tags-name: [];
    in-out property <[int]> tags-usage: [];
    in-out property <bool> import-offer-visible: false;
    in-out property <string> import-offer-parent: "";
    in-out property <int> import-offer-children: 0;
    in-out property <string> import-offer-hover: "";
    in-out property <string> notice-text: "";
    in-out property <bool> has-pending-remove: false;
    in-out property <string> pending-remove-name: "";
    in-out property <int> pending-remove-seconds: 0;

    // --- callbacks (commands to Rust) ---
    callback close-settings();
    callback command-show-page(int);
    callback command-add();
    callback command-paste();
    callback command-browse();
    // M05 review C1: folder row actions pass the ROW INDEX (not a truncated id);
    // Rust resolves index→FolderId from the current rows snapshot.
    callback command-edit(int);
    callback command-remove(int);
    callback command-toggle-enabled(int);
    callback command-toggle-pin(int);
    callback command-check(int);
    callback command-create-category(string);
    callback command-delete-category(int);
    callback command-confirm-delete-category(int);
    callback command-cancel-delete-category();
    callback command-create-tag(string);
    callback command-delete-tag(int);
    callback command-confirm-delete-tag(int);
    callback command-cancel-delete-tag();
    callback command-filter-name(string);
    callback command-filter-category(int);
    callback command-filter-enabled(int);
    callback command-set-sort(int);
    callback command-confirm-remove();
    callback command-cancel-remove();
    callback command-undo-remove();
    callback command-import-parent-only();
    callback command-import-children();
    callback command-import-dismiss();
    callback command-save-draft();
    callback command-cancel-draft();
    callback command-set-draft-name(string);
    callback command-set-draft-path(string);
    callback command-set-draft-note(string);
    callback command-toggle-pinned();
    callback command-toggle-favorite();
    callback command-set-enabled(bool);
    callback command-set-draft-weight(int);
    callback command-cycle-draft-color();
    callback command-set-draft-category(int);
    callback command-toggle-draft-tag(int, bool);
    callback command-resolve-duplicate(int);
    callback command-set-one-level-import(bool);
    callback command-apply-batch();
    callback command-cancel-batch();

    // --- local edit state for the drafts ---
    in-out property <string> draft-name: "";
    in-out property <string> draft-path: "";
    in-out property <string> draft-note: "";
    in-out property <bool> draft-visible: false;
    in-out property <string> draft-title: "";
    in-out property <string> draft-error: "";
    in-out property <color> draft-color: #00000000;
    in-out property <int> draft-weight: 0;
    in-out property <bool> draft-duplicate: false;
    in-out property <bool> draft-unsaved: false;
    // UI-local: the unsaved-edit Cancel went through the two-step confirm.
    in-out property <bool> draft-confirm-cancel: false;
    // M05 review L1: the draft enabled flag (wired via `command-set-enabled`).
    in-out property <bool> draft-enabled: true;
    in-out property <[string]> draft-categories-model: [];
    in-out property <int> draft-category-index: 0;
    in-out property <[string]> draft-tags-model: [];
    in-out property <[bool]> draft-tags-state: [];
    // M05 review H3: per-row delete-confirmation arming (-1 = none armed).
    in-out property <int> confirm-category-index: -1;
    in-out property <int> confirm-tag-index: -1;
    // M05 review M1: the one-level-import user-facing toggle (default OFF).
    in-out property <bool> one-level-import-on: false;
    // M05 review M2: folder-list filter + sort controls.
    in-out property <[string]> filter-category-model: [];
    in-out property <int> filter-category-index: 0;
    in-out property <int> filter-status-index: 0;
    in-out property <int> sort-index: 0;
    // UI-local delete-confirm confirmation text state.
    in-out property <string> confirm-banner: "";
    in-out property <bool> batch-visible: false;
    in-out property <int> batch-count: 0;
    in-out property <[string]> batch-name: [];
    in-out property <[string]> batch-path: [];
    in-out property <[bool]> batch-dup: [];
    in-out property <[bool]> batch-invalid: [];

    // ---- M06 settings state (pushed from Rust via the settings controller) ----
    // These mirror AppSettings + SView so every .slint control binds a real
    // persisted value; nothing here is a dead control.
    // 常规
    in-out property <bool> s-launch-at-login: false;
    in-out property <bool> s-silent-start: true;
    in-out property <bool> s-show-main: false;
    in-out property <bool> s-hide-after-open: true;
    in-out property <bool> s-clear-after-open: true;
    in-out property <bool> s-hide-on-focus-loss: true;
    in-out property <int> s-monitor-strategy: 0;
    in-out property <int> s-language: 0;
    in-out property <bool> s-confirm-restore-defaults: false;
    // 搜索
    in-out property <bool> s-search-paths: true;
    in-out property <bool> s-search-categories: true;
    in-out property <bool> s-search-tags: true;
    in-out property <bool> s-search-notes: false;
    in-out property <bool> s-search-aliases: true;
    in-out property <bool> s-fuzzy: true;
    in-out property <bool> s-pinyin: true;
    in-out property <bool> s-english-initials: true;
    in-out property <int> s-edit-distance: 1;
    in-out property <int> s-max-results: 8;
    in-out property <int> s-empty-query: 0;
    in-out property <bool> s-highlight: true;
    in-out property <bool> s-recent-sort: false;
    // 外观
    in-out property <int> s-theme: 0;
    in-out property <int> s-row-height: 0;
    in-out property <int> s-search-width: 600;
    in-out property <int> s-settings-width: 900;
    in-out property <int> s-font-scale: 100;
    in-out property <bool> s-show-path: true;
    in-out property <bool> s-show-cat-tag: true;
    // 快捷键
    in-out property <int> s-hotkey-runtime: 0;
    in-out property <string> s-hotkey-text: "";
    in-out property <string> s-hotkey-error: "";
    in-out property <bool> s-recording: false;
    in-out property <string> s-record-draft: "";
    // 数据
    in-out property <string> s-data-location: "";
    in-out property <int> s-folder-count: 0;
    in-out property <[string]> s-backups: [];
    in-out property <bool> s-import-preview: false;
    in-out property <int> s-import-added: 0;
    in-out property <int> s-import-updated: 0;
    in-out property <int> s-import-skipped: 0;
    in-out property <int> s-import-conflicts: 0;
    in-out property <[string]> s-import-added-names: [];
    in-out property <[string]> s-import-updated-names: [];
    in-out property <[string]> s-import-skipped-names: [];
    in-out property <int> s-import-mode: 0;
    in-out property <bool> s-confirm-clear-all: false;
    in-out property <bool> s-confirm-reset: false;
    // 关于
    in-out property <string> s-about-version: "";
    in-out property <string> s-about-arch: "";
    in-out property <string> s-about-project: "";
    in-out property <string> s-about-license: "";
    in-out property <string> s-about-privacy: "";
    // M05-deferral rename/merge UI states (per-row, UI-local).
    in-out property <int> rename-category-index: -1;
    in-out property <int> rename-tag-index: -1;
    in-out property <int> merge-armed-index: -1;

    callback s-close();
    callback s-show-page(int);
    callback s-command-launch-at-login(bool);
    callback s-command-silent-start(bool);
    callback s-command-show-main(bool);
    callback s-command-hide-after-open(bool);
    callback s-command-clear-after-open(bool);
    callback s-command-hide-on-focus-loss(bool);
    callback s-command-monitor-strategy(int);
    callback s-command-language(int);
    callback s-command-restore-defaults();
    callback s-command-search-paths(bool);
    callback s-command-search-categories(bool);
    callback s-command-search-tags(bool);
    callback s-command-search-notes(bool);
    callback s-command-search-aliases(bool);
    callback s-command-fuzzy(bool);
    callback s-command-pinyin(bool);
    callback s-command-english-initials(bool);
    callback s-command-edit-distance(int);
    callback s-command-max-results(int);
    callback s-command-empty-query(int);
    callback s-command-highlight(bool);
    callback s-command-recent-sort(bool);
    callback s-command-theme(int);
    callback s-command-row-height(int);
    callback s-command-search-width(int);
    callback s-command-settings-width(int);
    callback s-command-font-scale(int);
    callback s-command-show-path(bool);
    callback s-command-show-cat-tag(bool);
    callback s-command-hotkey-record();
    callback s-command-hotkey-cancel();
    callback s-command-hotkey-pause();
    callback s-command-hotkey-resume();
    callback s-command-hotkey-clear();
    callback s-command-hotkey-restore();
    // modifiers (control/alt/shift/meta) + the key's unicode text.
    callback s-command-hotkey-key(bool, bool, bool, bool, string);
    callback s-command-open-data-dir();
    callback s-command-export();
    callback s-command-import();
    callback s-command-apply-import();
    callback s-command-cancel-import();
    callback s-command-set-import-mode(int);
    callback s-command-create-backup();
    callback s-command-list-backups();
    callback s-command-restore-backup(int);
    callback s-command-clear-recent();
    // M06 review L2: the two-step confirm state is local (`s-confirm-*`);
    // only the final confirm callbacks are wired to Rust (no dead arm/cancel).
    callback s-command-confirm-clear-all();
    callback s-command-confirm-reset();
    callback s-command-rename-category(int, string);
    callback s-command-rename-tag(int, string);
    callback s-command-merge-tag(int, string);

    HorizontalBox {
        padding: 12px;
        spacing: 12px;

        // ===== left navigation =====
        VerticalBox {
            width: 180px;
            spacing: 4px;
            Rectangle {
                height: 24px;
                Text { text: UiStrings.settings-title; color: UiTheme.text; font-size: 15px; font-weight: 600; }
            }
            Button {
                text: UiStrings.settings-general;
                checked: root.page == 0;
                clicked() => { root.s-show-page(0); }
            }
            Button {
                text: UiStrings.page-folders;
                checked: root.page == 1;
                clicked() => { root.s-show-page(1); }
            }
            Button {
                text: UiStrings.page-categories;
                checked: root.page == 2;
                clicked() => { root.s-show-page(2); }
            }
            Button {
                text: UiStrings.page-tags;
                checked: root.page == 3;
                clicked() => { root.s-show-page(3); }
            }
            Button {
                text: UiStrings.settings-search;
                checked: root.page == 4;
                clicked() => { root.s-show-page(4); }
            }
            Button {
                text: UiStrings.settings-appearance;
                checked: root.page == 5;
                clicked() => { root.s-show-page(5); }
            }
            Button {
                text: UiStrings.settings-hotkey;
                checked: root.page == 6;
                clicked() => { root.s-show-page(6); }
            }
            Button {
                text: UiStrings.settings-data;
                checked: root.page == 7;
                clicked() => { root.s-show-page(7); }
            }
            Button {
                text: UiStrings.settings-about;
                checked: root.page == 8;
                clicked() => { root.s-show-page(8); }
            }
        }

        // ===== right content =====
        VerticalBox {
            horizontal-stretch: 1;
            spacing: 8px;

            NoticeBar { v-text: root.notice-text; }

            // ===== 0 常规 =====
            if (root.page == 0): VerticalBox {
                spacing: 8px;
                ScrollView {
                    height: 400px;
                    VerticalBox {
                        spacing: 4px;
                        // 随 Windows 启动（HKCU Run, per-user, 无提权）.
                        SwitchRow { m-text: UiStrings.settings-mono-launch-at-login; t-checked <=> root.s-launch-at-login; t-toggle() => { root.s-command-launch-at-login(root.s-launch-at-login); } }
                        SwitchRow { m-text: UiStrings.settings-mono-silent-start; t-checked <=> root.s-silent-start; t-toggle() => { root.s-command-silent-start(root.s-silent-start); } }
                        SwitchRow { m-text: UiStrings.settings-mono-show-main; t-checked <=> root.s-show-main; t-toggle() => { root.s-command-show-main(root.s-show-main); } }
                        Text { text: UiStrings.settings-mono-start-notification-none; color: UiTheme.text-secondary; font-size: 12px; }
                        Text { text: UiStrings.settings-mono-start-notification; color: UiTheme.text; font-size: 13px; }
                        SwitchRow { m-text: UiStrings.settings-mono-hide-after-open; t-checked <=> root.s-hide-after-open; t-toggle() => { root.s-command-hide-after-open(root.s-hide-after-open); } }
                        SwitchRow { m-text: UiStrings.settings-mono-clear-after-open; t-checked <=> root.s-clear-after-open; t-toggle() => { root.s-command-clear-after-open(root.s-clear-after-open); } }
                        SwitchRow { m-text: UiStrings.settings-mono-hide-on-focus-loss; t-checked <=> root.s-hide-on-focus-loss; t-toggle() => { root.s-command-hide-on-focus-loss(root.s-hide-on-focus-loss); } }
                        ComboRow {
                            m-text: UiStrings.settings-mono-monitor-strategy;
                            ComboBox {
                                model: [UiStrings.settings-mono-monitor-mouse, UiStrings.settings-mono-monitor-active-window];
                                current-index <=> root.s-monitor-strategy;
                                selected(cv) => { root.s-command-monitor-strategy(root.s-monitor-strategy); }
                            }
                        }
                        ComboRow {
                            m-text: UiStrings.settings-mono-language;
                            ComboBox {
                                model: [UiStrings.settings-mono-language-system, UiStrings.settings-mono-language-zhcn, UiStrings.settings-mono-language-enus];
                                current-index <=> root.s-language;
                                selected(cv) => { root.s-command-language(root.s-language); }
                            }
                        }
                        // 恢复默认设置（两项确认：先展示影响，再执行）。
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: UiStrings.settings-mono-restore-defaults-impact; color: UiTheme.text-secondary; font-size: 12px; horizontal-stretch: 1; }
                            if !root.s-confirm-restore-defaults : Button { text: UiStrings.settings-mono-restore-defaults; clicked() => { root.s-confirm-restore-defaults = true; } }
                            if root.s-confirm-restore-defaults : Button { text: UiStrings.settings-mono-restore-defaults-confirm; clicked() => { root.s-confirm-restore-defaults = false; root.s-command-restore-defaults(); } }
                            if root.s-confirm-restore-defaults : Button { text: UiStrings.cancel; clicked() => { root.s-confirm-restore-defaults = false; } }
                        }
                    }
                }
            }

            // ===== 1 文件夹（M05 管理页）=====
            if (root.page == 1): VerticalBox {
                spacing: 8px;
                // M05 review M2: name filter, category filter, status filter and
                // the sort selector are bound to the existing pure logic.
                HorizontalBox {
                    spacing: 8px;
                    LineEdit {
                        placeholder-text: UiStrings.filter-name-placeholder;
                        horizontal-stretch: 1;
                        edited(text) => { root.command-filter-name(text); }
                    }
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.filter-category-model;
                        current-index <=> root.filter-category-index;
                        selected(cv) => { root.command-filter-category(root.filter-category-index); }
                    }
                    ComboBox {
                        model: [UiStrings.filter-status-all, UiStrings.filter-status-enabled, UiStrings.filter-status-disabled];
                        current-index <=> root.filter-status-index;
                        selected(cv) => { root.command-filter-enabled(root.filter-status-index); }
                    }
                    ComboBox {
                        model: [UiStrings.sort-name, UiStrings.sort-recent, UiStrings.sort-added];
                        current-index <=> root.sort-index;
                        selected(cv) => { root.command-set-sort(root.sort-index); }
                    }
                    Button { text: UiStrings.action-add; clicked() => { root.command-add(); } }
                }
                HorizontalBox {
                    spacing: 8px;
                    // M05 review M1: the user-facing enablement for controlled
                    // one-level import (default OFF, persisted).
                    Text { text: UiStrings.import-offer-title; color: UiTheme.text-secondary; font-size: 12px; }
                    Switch {
                        checked: root.one-level-import-on;
                        toggled() => { root.command-set-one-level-import(root.one-level-import-on); }
                    }
                    Text { text: UiStrings.import-second-confirm; color: UiTheme.text-secondary; font-size: 11px; }
                }
                ScrollView {
                    height: 400px;
                    VerticalBox {
                        spacing: 2px;
                        for i in root.rows-count: FolderManagementRow {
                            m-id: i;
                            m-name: root.rows-name[i];
                            m-path: root.rows-path[i];
                            m-category: root.rows-category[i];
                            m-tags: root.rows-tags[i];
                            m-enabled: root.rows-enabled[i];
                            m-pinned: root.rows-pinned[i];
                            compact-rows: root.s-row-height == 0;
                            command-edit(id) => { root.command-edit(id); }
                            command-remove(id) => { root.command-remove(id); }
                            command-toggle-enabled(id) => { root.command-toggle-enabled(id); }
                            command-toggle-pin(id) => { root.command-toggle-pin(id); }
                            command-check(id) => { root.command-check(id); }
                        }
                        if (root.rows-count == 0): Text {
                            text: UiStrings.field-not-empty;
                            color: UiTheme.text-secondary;
                            font-size: 13px;
                        }
                    }
                }
                if (root.has-pending-remove): Rectangle {
                    height: 72px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: UiTheme.border;
                    background: UiTheme.surface;
                    VerticalBox {
                        padding: 8px;
                        spacing: 4px;
                        Text { text: UiStrings.remove-confirm + " · " + root.pending-remove-name; color: UiTheme.text; font-size: 12px; }
                        Text { text: UiStrings.remove-never-deletes; color: UiTheme.warning; font-size: 11px; }
                        HorizontalBox {
                            spacing: 8px;
                            Button { text: UiStrings.undo; clicked() => { root.command-undo-remove(); } }
                            // M05-L2: "取消/Keep removed" clearly means "the
                            // record STAYS removed, dismiss the undo banner"
                            // (not "cancel the removal").
                            Button { text: UiStrings.undo-dismiss; clicked() => { root.command-cancel-remove(); } }
                        }
                    }
                }
            }

            // ===== 2 分类（M05 管理页 + M06 重命名）=====
            if (root.page == 2): VerticalBox {
                spacing: 8px;
                HorizontalBox {
                    spacing: 8px;
                    cat-input := LineEdit {
                        placeholder-text: UiStrings.category-create;
                        horizontal-stretch: 1;
                        text: "";
                    }
                    Button { text: UiStrings.category-create; clicked() => { root.command-create-category(cat-input.text); cat-input.text = ""; } }
                }
                ScrollView {
                    height: 400px;
                    VerticalBox {
                        spacing: 2px;
                        for i in root.categories-count: HorizontalBox {
                            spacing: 8px;
                            height: 34px;
                            Text { text: root.categories-name[i]; color: UiTheme.text; font-size: 13px; horizontal-stretch: 1; }
                            Text { text: root.categories-counts[i] + UiStrings.usage-suffix; color: UiTheme.text-secondary; font-size: 12px; }
                            // M05 review H3: two-step delete confirm. First click
                            // arms this row's confirm state; only the explicit
                            // confirm performs the delete (folder → 未分类).
                            if (root.confirm-category-index == i) : HorizontalBox {
                                spacing: 4px;
                                Button { text: UiStrings.confirm-delete-category; clicked() => { root.command-confirm-delete-category(i); root.confirm-category-index = -1; } }
                                Button { text: UiStrings.cancel; clicked() => { root.confirm-category-index = -1; } }
                            }
                            if (root.confirm-category-index != i) : Button { text: UiStrings.category-delete; clicked() => { root.confirm-category-index = i; } }
                            // M06 deferral: category RENAME (atomic save). The
                            // rename input is per-row; Cancel reset the line.
                            if (root.rename-category-index == i) : HorizontalBox {
                                spacing: 4px;
                                name-edit := LineEdit { text: root.categories-name[i]; horizontal-stretch: 1; }
                                Button { text: UiStrings.settings-category-rename; clicked() => { root.s-command-rename-category(i, name-edit.text); root.rename-category-index = -1; } }
                                Button { text: UiStrings.cancel; clicked() => { root.rename-category-index = -1; } }
                            }
                            if (root.rename-category-index != i) : Button { text: UiStrings.settings-category-rename; clicked() => { root.rename-category-index = i; } }
                        }
                        if (root.categories-count == 0): Text { text: UiStrings.field-not-empty; color: UiTheme.text-secondary; font-size: 13px; }
                    }
                }
            }

            // ===== 3 标签（M05 管理页 + M06 重命名/合并）=====
            if (root.page == 3): VerticalBox {
                spacing: 8px;
                HorizontalBox {
                    spacing: 8px;
                    tag-input := LineEdit {
                        placeholder-text: UiStrings.tag-create;
                        horizontal-stretch: 1;
                        text: "";
                    }
                    Button { text: UiStrings.tag-create; clicked() => { root.command-create-tag(tag-input.text); tag-input.text = ""; } }
                }
                ScrollView {
                    height: 400px;
                    VerticalBox {
                        spacing: 2px;
                        for i in root.tags-count: HorizontalBox {
                            spacing: 8px;
                            height: 34px;
                            Text { text: root.tags-name[i]; color: UiTheme.text; font-size: 13px; horizontal-stretch: 1; }
                            Text { text: root.tags-usage[i] + UiStrings.usage-suffix; color: UiTheme.text-secondary; font-size: 12px; }
                            // M05 review H3: two-step delete confirm. The
                            // confirmed delete only clears folder references.
                            if (root.confirm-tag-index == i) : HorizontalBox {
                                spacing: 4px;
                                Button { text: UiStrings.confirm-delete-tag; clicked() => { root.command-confirm-delete-tag(i); root.confirm-tag-index = -1; } }
                                Button { text: UiStrings.cancel; clicked() => { root.confirm-tag-index = -1; } }
                            }
                            if (root.confirm-tag-index != i) : Button { text: UiStrings.tag-delete; clicked() => { root.confirm-tag-index = i; } }
                            // M06 deferral: tag RENAME (atomic save).
                            if (root.rename-tag-index == i) : HorizontalBox {
                                spacing: 4px;
                                tag-name-edit := LineEdit { text: root.tags-name[i]; horizontal-stretch: 1; }
                                Button { text: UiStrings.settings-tag-rename; clicked() => { root.s-command-rename-tag(i, tag-name-edit.text); root.rename-tag-index = -1; } }
                                Button { text: UiStrings.cancel; clicked() => { root.rename-tag-index = -1; } }
                            }
                            if (root.rename-tag-index != i) : Button { text: UiStrings.settings-tag-rename; clicked() => { root.rename-tag-index = i; } }
                            // M06 deferral: tag MERGE (two-step: arm then merge).
                            if (root.merge-armed-index == i) : RoundBox {
                                HorizontalBox {
                                    spacing: 6px;
                                    Text { text: UiStrings.settings-tag-merge-into + " " + UiStrings.settings-tag-merge-confirm; color: UiTheme.warning; font-size: 11px; }
                                    merge-target := LineEdit {
                                        placeholder-text: UiStrings.settings-tag-merge-into;
                                        horizontal-stretch: 1;
                                        text: i > 0 ? root.tags-name[0] : (root.tags-count > 1 ? root.tags-name[1] : "");
                                    }
                                    Button { text: UiStrings.settings-tag-merge-confirm; clicked() => { root.s-command-merge-tag(i, merge-target.text); root.merge-armed-index = -1; } }
                                    Button { text: UiStrings.cancel; clicked() => { root.merge-armed-index = -1; } }
                                }
                            }
                            if (root.merge-armed-index != i) : Button { text: UiStrings.settings-tag-merge-into; clicked() => { root.merge-armed-index = i; } }
                        }
                        if (root.tags-count == 0): Text { text: UiStrings.field-not-empty; color: UiTheme.text-secondary; font-size: 13px; }
                    }
                }
            }

            // ===== 4 搜索 =====
            if (root.page == 4): VerticalBox {
                spacing: 4px;
                ScrollView {
                    height: 400px;
                    VerticalBox {
                        spacing: 4px;
                        // 字段开关：全部即时生效（搜索核心直接消费）。
                        SwitchRow { m-text: UiStrings.settings-search-paths; t-checked <=> root.s-search-paths; t-toggle() => { root.s-command-search-paths(root.s-search-paths); } }
                        SwitchRow { m-text: UiStrings.settings-search-categories; t-checked <=> root.s-search-categories; t-toggle() => { root.s-command-search-categories(root.s-search-categories); } }
                        SwitchRow { m-text: UiStrings.settings-search-tags; t-checked <=> root.s-search-tags; t-toggle() => { root.s-command-search-tags(root.s-search-tags); } }
                        SwitchRow { m-text: UiStrings.settings-search-notes; t-checked <=> root.s-search-notes; t-toggle() => { root.s-command-search-notes(root.s-search-notes); } }
                        SwitchRow { m-text: UiStrings.settings-search-aliases; t-checked <=> root.s-search-aliases; t-toggle() => { root.s-command-search-aliases(root.s-search-aliases); } }
                        SwitchRow { m-text: UiStrings.settings-search-fuzzy; t-checked <=> root.s-fuzzy; t-toggle() => { root.s-command-fuzzy(root.s-fuzzy); } }
                        SwitchRow { m-text: UiStrings.settings-search-pinyin; t-checked <=> root.s-pinyin; t-toggle() => { root.s-command-pinyin(root.s-pinyin); } }
                        SwitchRow { m-text: UiStrings.settings-search-english-initials; t-checked <=> root.s-english-initials; t-toggle() => { root.s-command-english-initials(root.s-english-initials); } }
                        SwitchRow { m-text: UiStrings.settings-search-highlight; t-checked <=> root.s-highlight; t-toggle() => { root.s-command-highlight(root.s-highlight); } }
                        ComboRow {
                            m-text: UiStrings.settings-search-max-edit-distance;
                            ComboBox {
                                model: ["0", "1", "2"];
                                current-index <=> root.s-edit-distance;
                                selected(cv) => { root.s-command-edit-distance(root.s-edit-distance); }
                            }
                        }
                        ComboRow {
                            m-text: UiStrings.settings-search-max-results;
                            SpinBox {
                                minimum: 1; maximum: 100;
                                value: root.s-max-results;
                                edited(v) => { root.s-command-max-results(v); }
                            }
                        }
                        ComboRow {
                            m-text: UiStrings.settings-search-empty-query;
                            ComboBox {
                                model: [UiStrings.settings-search-empty-query-favorites-first, UiStrings.settings-search-empty-query-all, UiStrings.settings-search-empty-query-pinned-only, UiStrings.settings-search-empty-query-blank];
                                current-index <=> root.s-empty-query;
                                selected(cv) => { root.s-command-empty-query(root.s-empty-query); }
                            }
                        }
                        SwitchRow { m-text: UiStrings.settings-search-recent-sort; t-checked <=> root.s-recent-sort; t-toggle() => { root.s-command-recent-sort(root.s-recent-sort); } }
                        Text { text: UiStrings.settings-search-recent-sort-hint; color: UiTheme.text-secondary; font-size: 12px; }
                        Text { text: UiStrings.settings-search-history-future; color: UiTheme.text-secondary; font-size: 12px; }
                    }
                }
            }

            // ===== 5 外观 =====
            if (root.page == 5): VerticalBox {
                spacing: 4px;
                ScrollView {
                    height: 400px;
                    VerticalBox {
                        spacing: 4px;
                        ComboRow {
                            m-text: UiStrings.settings-appearance-theme;
                            ComboBox {
                                model: [UiStrings.settings-appearance-theme-system, UiStrings.settings-appearance-theme-light, UiStrings.settings-appearance-theme-dark];
                                current-index <=> root.s-theme;
                                selected(cv) => { root.s-command-theme(root.s-theme); }
                            }
                        }
                        ComboRow {
                            m-text: UiStrings.settings-appearance-row-height;
                            ComboBox {
                                model: [UiStrings.settings-appearance-row-height-compact, UiStrings.settings-appearance-row-height-standard];
                                current-index <=> root.s-row-height;
                                selected(cv) => { root.s-command-row-height(root.s-row-height); }
                            }
                        }
                        ComboRow {
                            m-text: UiStrings.settings-appearance-search-width;
                            SpinBox {
                                minimum: 480; maximum: 760;
                                value: root.s-search-width;
                                edited(v) => { root.s-command-search-width(v); }
                            }
                        }
                        ComboRow {
                            m-text: UiStrings.settings-appearance-settings-width;
                            SpinBox {
                                minimum: 760; maximum: 1600;
                                value: root.s-settings-width;
                                edited(v) => { root.s-command-settings-width(v); }
                            }
                        }
                        ComboRow {
                            m-text: UiStrings.settings-appearance-font-scale;
                            SpinBox {
                                minimum: 80; maximum: 150;
                                value: root.s-font-scale;
                                edited(v) => { root.s-command-font-scale(v); }
                            }
                        }
                        SwitchRow { m-text: UiStrings.settings-appearance-show-path; t-checked <=> root.s-show-path; t-toggle() => { root.s-command-show-path(root.s-show-path); } }
                        SwitchRow { m-text: UiStrings.settings-appearance-show-cat-tag; t-checked <=> root.s-show-cat-tag; t-toggle() => { root.s-command-show-cat-tag(root.s-show-cat-tag); } }
                        // OS-level effects Slint 1.18 cannot apply: honest 后续版本.
                        SwitchRow { m-text: UiStrings.settings-appearance-transparency; future: true; }
                        SwitchRow { m-text: UiStrings.settings-appearance-high-contrast; future: true; }
                    }
                }
            }

            // ===== 6 快捷键 =====
            if (root.page == 6): VerticalBox {
                spacing: 4px;
                ScrollView {
                    height: 400px;
                    VerticalBox {
                        spacing: 6px;
                        // 当前运行状态（来自 native 机器）。
                        Text {
                            text: UiStrings.settings-hotkey-current + ": "
                                + (root.s-hotkey-runtime == 2 ? UiStrings.settings-hotkey-state-paused
                                   : (root.s-hotkey-runtime == 1 ? root.s-hotkey-text
                                      : (root.s-hotkey-text.is-empty ? UiStrings.settings-hotkey-none : root.s-hotkey-text)));
                            color: UiTheme.text; font-size: 13px;
                        }
                        Text { text: UiStrings.settings-hotkey-state-disabled + " / " + UiStrings.settings-hotkey-state-active + " / " + UiStrings.settings-hotkey-state-paused; color: UiTheme.text-secondary; font-size: 11px; }
                        if !root.s-hotkey-error.is-empty : Text { text: root.s-hotkey-error; color: UiTheme.warning; font-size: 12px; }

                        if !root.s-recording : HorizontalBox {
                            spacing: 8px;
                            Button { text: UiStrings.settings-hotkey-record; clicked() => { root.s-command-hotkey-record(); } }
                            if (root.s-hotkey-runtime == 1) : Button { text: UiStrings.settings-hotkey-pause; clicked() => { root.s-command-hotkey-pause(); } }
                            if (root.s-hotkey-runtime == 2) : Button { text: UiStrings.settings-hotkey-resume; clicked() => { root.s-command-hotkey-resume(); } }
                            Button { text: UiStrings.settings-hotkey-clear; clicked() => { root.s-command-hotkey-clear(); } }
                            Button { text: UiStrings.settings-hotkey-restore-default; clicked() => { root.s-command-hotkey-restore(); } }
                        }
                        if root.s-recording : Rectangle {
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: UiTheme.accent;
                            background: UiTheme.selection;
                            VerticalBox {
                                padding: 8px;
                                spacing: 4px;
                                Text { text: UiStrings.settings-hotkey-recording-hint + (root.s-record-draft.is-empty ? "" : ("  ·  " + root.s-record-draft)); color: UiTheme.text; font-size: 12px; }
                                hotkey-focus := FocusScope {
                                    focus-on-tab-navigation: true;
                                    // Capture a hotkey: modifiers (control/alt/shift)
                                    // + meta (Windows key) + the key's unicode text
                                    // (Slint 1.18 KeyEvent has only `text`/`modifiers`/
                                    // `repeat` — the adapter maps text → HotkeyKey).
                                    key-pressed(event) => {
                                        root.s-command-hotkey-key(event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta, event.text);
                                        accept
                                    }
                                }
                                Button { text: UiStrings.settings-hotkey-cancel-recording; clicked() => { root.s-command-hotkey-cancel(); } }
                            }
                        }
                    }
                }
            }

            // ===== 7 数据 =====
            if (root.page == 7): VerticalBox {
                spacing: 4px;
                ScrollView {
                    height: 400px;
                    VerticalBox {
                        spacing: 6px;
                        Text { text: UiStrings.settings-data-location; color: UiTheme.text; font-size: 13px; }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: root.s-data-location; color: UiTheme.text-secondary; font-size: 12px; horizontal-stretch: 1; overflow: elide; Tooltip { Text { text: root.s-data-location; } } }
                            Button { text: UiStrings.settings-data-open-dir; clicked() => { root.s-command-open-data-dir(); } }
                        }
                        Text { text: UiStrings.settings-data-folder-count + ": " + root.s-folder-count; color: UiTheme.text-secondary; font-size: 12px; }

                        // 导出 / 导入。
                        HorizontalBox {
                            spacing: 8px;
                            Button { text: UiStrings.settings-data-export; clicked() => { root.s-command-export(); } }
                            Button { text: UiStrings.settings-data-import; clicked() => { root.s-command-import(); } }
                        }

                        // 导入预览 + 模式 + 应用。
                        if root.s-import-preview : Rectangle {
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: UiTheme.border;
                            background: UiTheme.surface;
                            VerticalBox {
                                padding: 8px;
                                spacing: 4px;
                                Text { text: UiStrings.settings-data-import-preview-title; color: UiTheme.text; font-size: 13px; font-weight: 600; }
                                Text { text: UiStrings.settings-data-import-added + ": " + root.s-import-added + "  " + UiStrings.settings-data-import-updated + ": " + root.s-import-updated + "  " + UiStrings.settings-data-import-skipped + ": " + root.s-import-skipped + "  " + UiStrings.settings-data-import-conflicts + ": " + root.s-import-conflicts; color: UiTheme.text-secondary; font-size: 12px; }
                                ComboRow {
                                    m-text: UiStrings.settings-data-import-mode;
                                    ComboBox {
                                        model: [UiStrings.settings-data-import-mode-overwrite, UiStrings.settings-data-import-mode-merge, UiStrings.settings-data-import-mode-skip];
                                        current-index <=> root.s-import-mode;
                                        selected(cv) => { root.s-command-set-import-mode(root.s-import-mode); }
                                    }
                                }
                                HorizontalBox {
                                    spacing: 8px;
                                    // M06 review I3: applying is pointless (and
                                    // will be all-or-nothing refused) while the
                                    // preview has conflicts, so the Apply button
                                    // is disabled up front instead of only
                                    // failing on click.
                                    Button {
                                        text: UiStrings.settings-data-import-apply;
                                        enabled: root.s-import-conflicts == 0;
                                        clicked() => { root.s-command-apply-import(); }
                                    }
                                    Button { text: UiStrings.settings-data-import-cancel; clicked() => { root.s-command-cancel-import(); } }
                                }
                            }
                        }

                        // 备份：创建 / 列表 / 恢复。
                        HorizontalBox {
                            spacing: 8px;
                            Button { text: UiStrings.settings-data-backup-create; clicked() => { root.s-command-create-backup(); } }
                            Button { text: UiStrings.settings-data-backup-list; clicked() => { root.s-command-list-backups(); } }
                        }
                        if (root.s-backups.length > 0) : VerticalBox {
                            spacing: 2px;
                            for i in root.s-backups.length: HorizontalBox {
                                spacing: 8px;
                                Text { text: root.s-backups[i]; color: UiTheme.text; font-size: 12px; horizontal-stretch: 1; }
                                Button { text: UiStrings.settings-data-backup-restore; clicked() => { root.s-command-restore-backup(i); } }
                            }
                        }
                        if (root.s-backups.length == 0) : Text { text: UiStrings.settings-data-backup-none; color: UiTheme.text-secondary; font-size: 12px; }

                        // 最近使用 / 重置 / 删除全部（危险操作在底部 + 两步确认）。
                        Text { text: UiStrings.settings-data-clear-recent; color: UiTheme.text; font-size: 13px; }
                        Text { text: UiStrings.settings-data-clear-recent-note; color: UiTheme.text-secondary; font-size: 12px; }
                        Button { text: UiStrings.settings-data-clear-recent; clicked() => { root.s-command-clear-recent(); } }

                        HorizontalBox {
                            spacing: 8px;
                            if !root.s-confirm-reset : Button { text: UiStrings.settings-data-reset-settings; clicked() => { root.s-confirm-reset = true; } }
                            if root.s-confirm-reset : Button { text: UiStrings.settings-data-reset-settings-confirm; clicked() => { root.s-confirm-reset = false; root.s-command-confirm-reset(); } }
                            if root.s-confirm-reset : Button { text: UiStrings.cancel; clicked() => { root.s-confirm-reset = false; } }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            if !root.s-confirm-clear-all : Button { text: UiStrings.settings-data-clear-all-records; clicked() => { root.s-confirm-clear-all = true; } }
                            if root.s-confirm-clear-all : Button { text: UiStrings.settings-data-clear-all-records-confirm; clicked() => { root.s-confirm-clear-all = false; root.s-command-confirm-clear-all(); } }
                            if root.s-confirm-clear-all : Button { text: UiStrings.cancel; clicked() => { root.s-confirm-clear-all = false; } }
                        }
                        if root.s-confirm-clear-all : Text { text: UiStrings.settings-data-clear-all-never-deletes; color: UiTheme.warning; font-size: 11px; }
                    }
                }
            }

            // ===== 8 关于 =====
            if (root.page == 8): VerticalBox {
                spacing: 8px;
                ScrollView {
                    height: 400px;
                    VerticalBox {
                        spacing: 6px;
                        Text { text: UiStrings.settings-about-version + ": " + root.s-about-version; color: UiTheme.text; font-size: 13px; }
                        Text { text: UiStrings.settings-about-arch + ": " + root.s-about-arch; color: UiTheme.text-secondary; font-size: 12px; }
                        Text { text: UiStrings.settings-about-project + ": " + root.s-about-project; color: UiTheme.text-secondary; font-size: 12px; }
                        Text { text: UiStrings.settings-about-license + ": " + root.s-about-license; color: UiTheme.text-secondary; font-size: 12px; }
                        Text { text: root.s-about-privacy; color: UiTheme.text-secondary; font-size: 12px; wrap: word-wrap; }
                    }
                }
            }

            // ===== add/edit dialog =====
            if (root.draft-visible): Rectangle {
                width: 100%;
                border-radius: 10px;
                border-width: 1px;
                border-color: UiTheme.border;
                background: UiTheme.surface;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: root.draft-title; color: UiTheme.text; font-size: 14px; font-weight: 600; }
                    // M05 review H2: unsaved-edit warning before leaving.
                    if root.draft-unsaved : Rectangle {
                        height: 22px;
                        border-radius: 4px;
                        background: UiTheme.selection;
                        Text { text: "⚠ " + UiStrings.unsaved-changes; color: UiTheme.warning; font-size: 11px; }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: UiStrings.field-name; color: UiTheme.text-secondary; }
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.draft-name;
                            edited(text) => { root.command-set-draft-name(text); }
                        }
                        Button { text: UiStrings.action-toggle-pin; clicked() => { root.command-toggle-pinned(); } }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: UiStrings.field-path; color: UiTheme.text-secondary; }
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.draft-path;
                            edited(text) => { root.command-set-draft-path(text); }
                        }
                        Button { text: UiStrings.paste; clicked() => { root.command-paste(); } }
                        Button { text: UiStrings.browse; clicked() => { root.command-browse(); } }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: UiStrings.field-note; color: UiTheme.text-secondary; }
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.draft-note;
                            placeholder-text: UiStrings.field-note;
                            edited(text) => { root.command-set-draft-note(text); }
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: UiStrings.field-category; color: UiTheme.text-secondary; }
                        ComboBox {
                            model: root.draft-categories-model;
                            current-index <=> root.draft-category-index;
                            selected(cv) => { root.command-set-draft-category(root.draft-category-index); }
                        }
                        Text { text: UiStrings.field-weight; color: UiTheme.text-secondary; }
                        SpinBox {
                            minimum: -100;
                            maximum: 100;
                            value: root.draft-weight;
                            edited(v) => { root.command-set-draft-weight(v); }
                        }
                        Text { text: UiStrings.field-color; color: UiTheme.text-secondary; }
                        Rectangle {
                            width: 22px;
                            height: 18px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: UiTheme.border;
                            background: root.draft-color;
                        }
                        Button { text: UiStrings.field-color; clicked() => { root.command-cycle-draft-color(); } }
                    }
                    if root.draft-tags-model.length > 0 : HorizontalBox {
                        spacing: 8px;
                        Text { text: UiStrings.field-tags; color: UiTheme.text-secondary; }
                        for tag[i] in root.draft-tags-model: tag-checkbox := CheckBox {
                            text: root.draft-tags-model[i];
                            checked: root.draft-tags-state[i];
                            toggled() => { root.command-toggle-draft-tag(i, tag-checkbox.checked); }
                        }
                    }
                    // M05 review L1: the draft enabled switch (wired to the
                    // previously-dead `command-set-enabled` callback).
                    HorizontalBox {
                        spacing: 8px;
                        enable-check := CheckBox {
                            text: UiStrings.enabled-label;
                            checked: root.draft-enabled;
                            toggled() => { root.command-set-enabled(enable-check.checked); }
                        }
                    }
                    NoticeBar { v-text: root.draft-error; }
                    // M05 review H2: duplicate-policy confirmation (a duplicate
                    // path was entered): edit existing / save as different name.
                    if root.draft-duplicate : HorizontalBox {
                        spacing: 8px;
                        Button { text: UiStrings.duplicate-cancel; clicked() => { root.command-resolve-duplicate(0); } }
                        Button { text: UiStrings.duplicate-edit-existing; clicked() => { root.command-resolve-duplicate(1); } }
                        Button { text: UiStrings.duplicate-save-different; clicked() => { root.command-resolve-duplicate(2); } }
                    }
                    HorizontalBox {
                        alignment: end;
                        spacing: 8px;
                        // M05 review H2: unsaved-edit Cancel is two-step.
                        if root.draft-unsaved && !root.draft-confirm-cancel : Button { text: UiStrings.cancel; clicked() => { root.draft-confirm-cancel = true; } }
                        if root.draft-unsaved && root.draft-confirm-cancel : Button { text: UiStrings.discard-changes; clicked() => { root.draft-confirm-cancel = false; root.command-cancel-draft(); } }
                        if root.draft-unsaved && root.draft-confirm-cancel : Button { text: UiStrings.discard-no; clicked() => { root.draft-confirm-cancel = false; } }
                        if !root.draft-unsaved : Button { text: UiStrings.cancel; clicked() => { root.command-cancel-draft(); } }
                        Button { text: UiStrings.save; clicked() => { root.draft-confirm-cancel = false; root.command-save-draft(); } }
                    }
                }
            }

            // ===== controlled one-level child import offer =====
            if (root.import-offer-visible): Rectangle {
                width: 100%;
                border-radius: 10px;
                border-width: 1px;
                border-color: UiTheme.border;
                background: UiTheme.surface;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: UiStrings.import-offer-title; color: UiTheme.text; font-size: 14px; font-weight: 600; }
                    Text {
                        text: root.import-offer-parent;
                        color: UiTheme.text-secondary;
                        font-size: 12px;
                        Tooltip { Text { text: root.import-offer-hover; } }
                    }
                    Text { text: UiStrings.import-second-confirm; color: UiTheme.warning; font-size: 12px; }
                    HorizontalBox {
                        spacing: 8px;
                        Button { text: UiStrings.import-parent-only; clicked() => { root.command-import-parent-only(); } }
                        Button { text: UiStrings.import-children + " (" + root.import-offer-children + ")"; clicked() => { root.command-import-children(); } }
                        Button { text: UiStrings.cancel; clicked() => { root.command-import-dismiss(); } }
                    }
                }
            }

            // ===== batch preview =====
            if (root.batch-visible): Rectangle {
                width: 100%;
                border-radius: 10px;
                border-width: 1px;
                border-color: UiTheme.border;
                background: UiTheme.surface;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: UiStrings.batch-preview-title; color: UiTheme.text; font-size: 14px; font-weight: 600; }
                    ScrollView {
                        horizontal-stretch: 1;
                        VerticalBox {
                            for i in root.batch-count: HorizontalBox {
                                spacing: 8px;
                                Text { text: root.batch-name[i]; color: UiTheme.text; font-size: 12px; horizontal-stretch: 1; }
                                if (root.batch-dup[i]): Text { text: UiStrings.batch-status-duplicate; color: UiTheme.warning; font-size: 12px; }
                                if (root.batch-invalid[i]): Text { text: UiStrings.batch-status-invalid; color: UiTheme.warning; font-size: 12px; }
                            }
                        }
                    }
                    HorizontalBox {
                        alignment: end;
                        spacing: 8px;
                        Button { text: UiStrings.cancel; clicked() => { root.command-cancel-batch(); } }
                        Button { text: UiStrings.batch-add; clicked() => { root.command-apply-batch(); } }
                    }
                }
            }
        }
    }
}

// Keep the tray shell (M00) intact — wiring stays in M04.
export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../assets/icons/filego-tray.png");
    title: "FileGo";
    tooltip: "FileGo";

    callback toggle-window();
    callback open-window();
    callback quit-requested();
    // ---- M04.1 tray actions ---------------------------------------------
    callback add-folder();
    callback open-settings();
    callback toggle-launch-at-login();
    callback toggle-pause-hotkeys();
    callback show-about();
    // Checkbox-style state is delivered as a text+glyph prefix (Slint's Windows
    // tray backend does not render `MF_CHECKED`; the task requires state to be
    // text+glyph, not color-only). The native menu rebuilds reactively when the
    // string changes. Empty when unchecked, "✓ " when checked. `in-out` so the
    // adapter can drive them from Rust (public setters are generated).
    in-out property <string> launch-at-login-glyph: "";
    in-out property <string> pause-hotkeys-glyph: "";
    // ---- M04-N001 closed (M07.1): hotkey-unavailable tray hint -----------
    // The tray remains fully usable when the global hotkey could not be
    // registered (Conflict / Unavailable). A disabled hint row is shown above
    // the Pause item when the hotkey is not active, via a localized anonymous
    // string that never contains a raw error code or path. The row is disabled
    // (Windows tray renders it greyed and non-activatable) and carries no
    // activation callback — it is informational only. Empty string hides it
    // (driven by the adapter: only a Disabled hotkey with a last error shows
    // the hint).
    in-out property <string> hotkey-unavailable-hint: "";

    clicked => { root.toggle-window(); }

    Menu {
        MenuItem {
            title: @tr("Open FileGo");
            activated => { root.open-window(); }
        }
        MenuItem {
            title: @tr("Add Folder…");
            activated => { root.add-folder(); }
        }
        MenuSeparator {}
        MenuItem {
            title: @tr("Settings");
            // M06 review H1: the tray Settings entry must reach the settings
            // window, so this item carries NO `enabled` gate (previously it was
            // hardcoded disabled and unreachable). The Rust side
            // (`tray.on_open_settings`) shows + focuses the SettingsWindow.
            activated => { root.open-settings(); }
        }
        MenuItem {
            title: root.launch-at-login-glyph + @tr("Launch at login");
            activated => { root.toggle-launch-at-login(); }
        }
        // M04-N001: only shown while the hotkey is unavailable; a disabled,
        // non-activatable row (the Windows backend renders `enabled: false`
        // greyed and unclickable) so the user can SEE why the shortcut does not
        // work but the tray keeps working. The string is anonymous + localized.
        if !root.hotkey-unavailable-hint.is-empty : MenuItem {
            title: root.hotkey-unavailable-hint;
            enabled: false;
        }
        MenuItem {
            title: root.pause-hotkeys-glyph + @tr("Pause hotkeys");
            activated => { root.toggle-pause-hotkeys(); }
        }
        MenuSeparator {}
        MenuItem {
            title: @tr("About FileGo");
            activated => { root.show-about(); }
        }
        MenuSeparator {}
        MenuItem {
            title: @tr("Exit");
            activated => { root.quit-requested(); }
        }
    }
}
